}
fun 1 execute_block(1 si, 1 hdr) {
  var pl = lds 1 (si + 0);
  var ntx = lds 1 (pl + 40);
  bo = alloc(88);
  memzero(bo, 88);
  var 1 txs = alloc(ntx * 16 + 16);
  st bo + 24, txs;
  var 1 rcs = alloc(ntx * 16 + 16);
  st bo + 32, rcs;
  var 1 logs = lst_new(8, 16);
  st bo + 40, logs;
  var 1 reqs = alloc(8 * 16);
  st bo + 56, reqs;
  var 1 rls = lst_new(8, 16);
  st bo + 72, rls;
  st bo + 80, ntx;
  bal_init();
  skip;
  process_unchecked_system_transaction(beacon_roots_address, lds 1 (si + 24), 32);
  var lasth = zero32;
  if block_hashes_n >+ 0 {
    lasth = block_hashes + (block_hashes_n - 1) * 32;
  }
  process_unchecked_system_transaction(history_storage_address, lasth, 32);
  skip;
  state_fresh_tx();
  track_ancestor_access(1);
  var ptxs = lds 1 (pl + 32);
  var i = 0;
  while i < ntx {
    var 1 tx = decode_transaction((lds 1 ((ptxs) + (i) * 16)), (lds 1 ((ptxs) + (i) * 16 + 8)));
    skip;
    process_transaction(tx, i);
    skip;
    i = i + 1;
  }
  bal_index = ntx + 1;
  skip;
  process_withdrawals(pl);
  skip;
  process_general_purpose_requests();
  skip;
  var {1,1} bal = build_block_access_list_rlp();
  validate_block_access_list_gas_limit(lds 1 (be + 8));
  skip;
