  return 0;
}
fun 1 run_attempt(1 si) {
  var pl = lds 1 (si + 0);
  skip;
  var {1,1} vh = validate_headers(lds 1 (si + 72), lds 1 (si + 80));
  var nh = lds 1 (si + 80);
  if nh == 0 {
    throw BlockErr 3;
  }
  var parent = lds 1 (vh.0 + (nh - 1) * 8);
  block_hashes = vh.1;
  block_hashes_n = nh;
  skip;
  var 1 nodedb = nodedb_build(lds 1 (si + 40), lds 1 (si + 48));
  var 1 codedb = nodedb_build(lds 1 (si + 56), lds 1 (si + 64));
  state_init(nodedb, lds 1 (parent + 32), codedb);
  skip;
  var txs = lds 1 (pl + 32);
  var ntx = lds 1 (pl + 40);
  var i = 0;
  while i < ntx {
    if (lds 1 ((txs) + (i) * 16 + 8)) == 0 {
      throw BlockErr 4;
