  if idx == 2 { pre_sha256(); return 0; }
  if idx == 3 { pre_ripemd160(); return 0; }
  if idx == 4 { pre_identity(); return 0; }
  if idx == 6 { pre_alt_bn128_add(); return 0; }
  if idx == 7 { pre_alt_bn128_mul(); return 0; }
  if idx == 8 { pre_alt_bn128_pairing_check(); return 0; }
  if idx == 5 { pre_modexp(); return 0; }
  if idx == 9 { pre_blake2f(); return 0; }
  if idx == 10 { pre_kzg_point_evaluation(); return 0; }
  if idx == 11 { pre_bls_g1_add(); return 0; }
  if idx == 12 { pre_bls_g1_msm(); return 0; }
  if idx == 13 { pre_bls_g2_add(); return 0; }
  if idx == 14 { pre_bls_g2_msm(); return 0; }
  if idx == 15 { pre_bls_pairing(); return 0; }
  if idx == 16 { pre_bls_map_fp_to_g1(); return 0; }
  if idx == 17 { pre_bls_map_fp2_to_g2(); return 0; }
  if idx == 18 { pre_p256verify(); return 0; }
