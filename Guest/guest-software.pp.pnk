  while idx < 6 {
    var bit = (((ld8 (h + idx)) << 8) | (ld8 (h + idx + 1))) & 2047;
    var bit_index = 2047 - bit;
    var byte_index = bit_index >>> 3;
    var bv = 1 << (7 - (bit_index & 7));
    st8 bloom + byte_index, (ld8 (bloom + byte_index)) | bv;
    idx = idx + 2;
