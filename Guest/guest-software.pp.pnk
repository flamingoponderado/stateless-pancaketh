  return 0;
}
fun 1 htab_union_into(1 dst, 1 src) {
  var cap = lds 1 (src + 24);
  var i = 0;
  while i < cap {
    var {1,1,1} s = htab_item(src, i);
    if s.0 != 0 {
      htab_set(dst, s.1, s.2);
    }
    i = i + 1;
  }
  return 0;
}
fun 1 merge_tx_into_block() {
  htab_union_into(lds 1 (bs + 24), lds 1 (ts + 24));
  htab_union_into(lds 1 (bs + 8), lds 1 (ts + 8));
  htab_union_into(lds 1 (bs + 40), lds 1 (ts + 40));
  htab_union_into(lds 1 (bs + 16), lds 1 (ts + 16));
  htab_union_into(lds 1 (bs + 48), lds 1 (ts + 48));
  var outer = lds 1 (ts + 32);
  var bouter = lds 1 (bs + 32);
  var cap = lds 1 (outer + 24);
  var i = 0;
  while i < cap {
    var {1,1,1} s = htab_item(outer, i);
    if s.0 != 0 {
      var {1,1} m = htab_get(bouter, s.1);
      var binner = 0;
      if m.0 == 0 {
        binner = htab_new(32, 8);
        htab_set(bouter, s.1, binner);
      } else {
        binner = m.1;
      }
