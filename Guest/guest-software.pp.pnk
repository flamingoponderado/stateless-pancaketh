    count = 16 * (elen - 32) + hbits;
  }
  if count <+ 1 {
    count = 1;
  }
  var cost = cplx * count;
  if cost <+ 500 {
    cost = 500;
  }
  return cost;
}
fun 1 pre_modexp() {
