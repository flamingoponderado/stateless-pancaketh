  st h + 16, f;
  f = hdr_bytes_field(arr, 2, 20);
  st h + 24, f;
  f = hdr_bytes_field(arr, 3, 32);
  st h + 32, f;
  f = hdr_bytes_field(arr, 4, 32);
  st h + 40, f;
  f = hdr_bytes_field(arr, 5, 32);
  st h + 48, f;
  f = hdr_bytes_field(arr, 6, 256);
  st h + 56, f;
  var {1,1,1,1} d = hdr_u256_field(arr, 7, 0);
  st h + 64, d;
  var 1 w = hdr_word_field(arr, 8);
  st h + 96, w;
  w = hdr_word_field(arr, 9);
  st h + 104, w;
  w = hdr_word_field(arr, 10);
  st h + 112, w;
  var {1,1} tsf = hdr_uint_field(arr, 11, 32);
  if tsf.1 >+ 8 {
    throw HdrErr 12;
  }
  w = hdr_word_field(arr, 11);
  st h + 120, w;
  var {1,1} ex = hdr_raw_field(arr, 12);
  st h + 128, ex.0;
  st h + 136, ex.1;
  f = hdr_bytes_field(arr, 13, 32);
  st h + 144, f;
  f = hdr_bytes_field(arr, 14, 8);
  st h + 152, f;
  d = hdr_u256_field(arr, 15, 0);
  st h + 160, d;
  f = hdr_bytes_field(arr, 16, 32);
  st h + 192, f;
  var {1,1} bg = hdr_uint_field(arr, 17, 8);
  w = hdr_word_field(arr, 17);
  st h + 200, w;
  bg = hdr_uint_field(arr, 18, 8);
  w = hdr_word_field(arr, 18);
  st h + 208, w;
  f = hdr_bytes_field(arr, 19, 32);
  st h + 216, f;
  f = hdr_bytes_field(arr, 20, 32);
  st h + 224, f;
  if is_current != 0 {
    f = hdr_bytes_field(arr, 21, 32);
    st h + 232, f;
    bg = hdr_uint_field(arr, 22, 8);
    w = hdr_word_field(arr, 22);
    st h + 240, w;
  } else {
    st h + 232, 0;
    st h + 240, 0;
  }
  return h;
}
fun 1 rlp_put_u256(1 dst, {1,1,1,1} v) {
  var 1 mark = heap_mark();
  var 1 tmp = alloc(32);
  var 1 n = u256_to_be_min(v, tmp);
  var 1 w = rlp_encode_bytes(dst, tmp, n);
  heap_release(mark);
  return w;
}
fun {1,1} encode_header(1 h) {
  var 1 buf = alloc(1024);
  var p = buf + 9;
  var 1 w = rlp_encode_bytes(p, lds 1 (h + 8), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 16), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 24), 20);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 32), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 40), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 48), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 56), 256);
  p = p + w;
  w = rlp_put_u256(p, lds {1,1,1,1} (h + 64));
  p = p + w;
  w = rlp_encode_word(p, lds 1 (h + 96));
  p = p + w;
  w = rlp_encode_word(p, lds 1 (h + 104));
  p = p + w;
  w = rlp_encode_word(p, lds 1 (h + 112));
  p = p + w;
  w = rlp_encode_word(p, lds 1 (h + 120));
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 128), lds 1 (h + 136));
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 144), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 152), 8);
  p = p + w;
  w = rlp_put_u256(p, lds {1,1,1,1} (h + 160));
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 192), 32);
  p = p + w;
  w = rlp_encode_word(p, lds 1 (h + 200));
  p = p + w;
  w = rlp_encode_word(p, lds 1 (h + 208));
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 216), 32);
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (h + 224), 32);
  p = p + w;
  if (lds 1 (h + 0)) != 0 {
    w = rlp_encode_bytes(p, lds 1 (h + 232), 32);
    p = p + w;
    w = rlp_encode_word(p, lds 1 (h + 240));
    p = p + w;
  }
  var payload_len = p - (buf + 9);
  var 1 hl = rlp_list_header_len(payload_len);
  var start = buf + 9 - hl;
  rlp_encode_list_header(start, payload_len);
  return <start, payload_len + hl>;
}
fun 1 header_hash(1 h, 1 out) {
  var 1 mark = heap_mark();
  var {1,1} e = encode_header(h);
  keccak256(e.0, e.1, out);
  heap_release(mark);
  return 0;
}
fun {1,1} validate_headers(1 arr, 1 n) {
  if n >+ 256 {
    throw BlockErr 1;
  }
  var 1 hs = alloc(n * 8 + 8);
  var 1 hashes = alloc(n * 32 + 32);
  var i = 0;
  while i < n {
    var 1 h = decode_header((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)));
    st hs + i * 8, h;
    keccak256((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)), hashes + i * 32);
    i = i + 1;
  }
  i = 1;
  while i < n {
    var 1 eq = memeq(lds 1 ((lds 1 (hs + i * 8)) + 8), hashes + (i - 1) * 32, 32);
    if eq == 0 {
      throw BlockErr 2;
    }
    i = i + 1;
  }
  return <hs, hashes>;
}
fun {1,1,1,1} taylor_exponential(1 factor, 1 numerator, 1 denominator) {
  var {1,1,1,1} den = u256_from_word(denominator);
  var {1,1,1,1} num = u256_from_word(numerator);
  var {1,1,1,1} acc = u256_from_word(factor);
  acc = u256_mul(acc, den);
  var {1,1,1,1} out = <0, 0, 0, 0>;
  var i = 1;
  var {1,1,1,1} zero = <0, 0, 0, 0>;
  var 1 nz = u256_is_zero(acc);
  while nz == 0 {
    out = u256_add(out, acc);
    var {1,1,1,1,1,1,1,1} prod = u256_mul_full(acc, num);
    if (prod.4 | prod.5 | prod.6 | prod.7) != 0 {
      trap_with(3);
    }
    var {1,1,1,1} p = <prod.0, prod.1, prod.2, prod.3>;
    var {1,1,1,1} di = u256_from_word(i);
    di = u256_mul(di, den);
    acc = u256_div(p, di);
    i = i + 1;
    nz = u256_is_zero(acc);
  }
  out = u256_div(out, den);
  return out;
}
fun {1,1,1,1} calculate_blob_gas_price(1 excess_blob_gas) {
  var {1,1,1,1} r = taylor_exponential(1, excess_blob_gas, 11684671);
  return r;
}
fun 1 calculate_excess_blob_gas(1 parent) {
  var excess = lds 1 (parent + 208);
  var used = lds 1 (parent + 200);
  var {1,1,1,1} base_fee = lds {1,1,1,1} (parent + 160);
  var parent_blob_gas = excess + used;
  if parent_blob_gas <+ 1835008 {
    return 0;
  }
  var {1,1,1,1} price = calculate_blob_gas_price(excess);
  var {1,1,1,1} per_blob = u256_from_word(131072);
  var {1,1,1,1} target_price = u256_mul(per_blob, price);
  var {1,1,1,1} base_cost = u256_from_word(8192);
  var {1,1,1,1} base_blob_tx_price = u256_mul(base_cost, base_fee);
  var 1 gt = u256_gt(base_blob_tx_price, target_price);
  if gt != 0 {
    var 1 q = udiv(used * (21 - 14), 21);
    return excess + q;
  }
  return parent_blob_gas - 1835008;
}
fun 1 check_gas_limit(1 gas_limit, 1 parent_gas_limit) {
  var 1 max_delta = udiv(parent_gas_limit, 1024);
  if gas_limit >=+ parent_gas_limit + max_delta {
    return 0;
  }
  if gas_limit + max_delta <=+ parent_gas_limit {
    return 0;
  }
  if gas_limit <+ 5000 {
    return 0;
  }
  return 1;
}
fun {1,1,1,1} calculate_base_fee_per_gas(1 block_gas_limit, 1 parent_gas_limit,
    1 parent_gas_used, {1,1,1,1} parent_base_fee) {
  var parent_gas_target = parent_gas_limit >>> 1;
  var 1 ok = check_gas_limit(block_gas_limit, parent_gas_limit);
  if ok == 0 {
    throw BlockErr 10;
  }
  if parent_gas_used == parent_gas_target {
    return parent_base_fee;
  }
  var {1,1,1,1} tgt = u256_from_word(parent_gas_target);
  var {1,1,1,1} eight = u256_from_word(8);
  if parent_gas_used >+ parent_gas_target {
    var {1,1,1,1} delta = u256_from_word(parent_gas_used - parent_gas_target);
    var {1,1,1,1} pfd = u256_mul(parent_base_fee, delta);
    var {1,1,1,1} tfd = u256_div(pfd, tgt);
    var {1,1,1,1} bfd = u256_div(tfd, eight);
    var 1 z = u256_is_zero(bfd);
    if z != 0 {
      bfd = u256_from_word(1);
    }
    var {1,1,1,1} r = u256_add(parent_base_fee, bfd);
    return r;
  }
  var {1,1,1,1} delta2 = u256_from_word(parent_gas_target - parent_gas_used);
  var {1,1,1,1} pfd2 = u256_mul(parent_base_fee, delta2);
  var {1,1,1,1} tfd2 = u256_div(pfd2, tgt);
  var {1,1,1,1} bfd2 = u256_div(tfd2, eight);
  var {1,1,1,1} r2 = u256_sub(parent_base_fee, bfd2);
  return r2;
}
var 1 hdr_zero8 = 0;
fun 1 header_init() {
  if hdr_zero8 != 0 {
    return 0;
  }
  hdr_zero8 = alloc(8);
  memzero(hdr_zero8, 8);
  return 0;
}
fun 1 validate_header(1 parent, 1 h) {
  if (lds 1 (h + 96)) <+ 1 {
    throw BlockErr 20;
  }
  var 1 ebg = calculate_excess_blob_gas(parent);
  if (lds 1 (h + 208)) != ebg {
    throw BlockErr 21;
  }
  if (lds 1 (h + 112)) >+ (lds 1 (h + 104)) {
    throw BlockErr 22;
  }
  var {1,1,1,1} expected = calculate_base_fee_per_gas(lds 1 (h + 104),
      lds 1 (parent + 104), lds 1 (parent + 112),
      lds {1,1,1,1} (parent + 160));
  var 1 eq = u256_eq(expected, lds {1,1,1,1} (h + 160));
  if eq == 0 {
    throw BlockErr 23;
  }
  if (lds 1 (h + 120)) <=+ (lds 1 (parent + 120)) {
    throw BlockErr 24;
  }
  if (lds 1 (h + 96)) != (lds 1 (parent + 96)) + 1 {
    throw BlockErr 25;
  }
  if (lds 1 (h + 136)) >+ 32 {
    throw BlockErr 26;
  }
  var 1 dz = u256_is_zero(lds {1,1,1,1} (h + 64));
  if dz == 0 {
    throw BlockErr 27;
  }
  eq = memeq(lds 1 (h + 152), hdr_zero8, 8);
  if eq == 0 {
    throw BlockErr 28;
  }
  var 1 mark = heap_mark();
  var 1 tmp = alloc(64);
  st8 tmp, 192;
  keccak256(tmp, 1, tmp + 32);
  eq = memeq(lds 1 (h + 16), tmp + 32, 32);
  if eq == 0 {
    heap_release(mark);
    throw BlockErr 29;
  }
  header_hash(parent, tmp);
  eq = memeq(lds 1 (h + 8), tmp, 32);
  heap_release(mark);
  if eq == 0 {
    throw BlockErr 30;
  }
  return 0;
}
exception MptErr : 1;
var 1 empty_trie_root = 0;
var 1 empty_code_hash = 0;
var 1 mpt_nib_scratch = 0;
var 1 mpt_hash_scratch = 0;
var 1 mpt_key_scratch = 0;
fun 1 mpt_fail(1 code) {
  throw MptErr code;
  return 0;
}
fun 1 mpt_init() {
  empty_trie_root = alloc(32);
  empty_code_hash = alloc(32);
  mpt_nib_scratch = alloc(64);
  mpt_hash_scratch = alloc(40);
  mpt_key_scratch = alloc(16);
  st8 mpt_hash_scratch, 128;
  keccak256(mpt_hash_scratch, 1, empty_trie_root);
  keccak256(mpt_hash_scratch, 0, empty_code_hash);
  return 0;
}
fun 1 key_to_nibbles(1 key, 1 n, 1 out) {
  var i = 0;
  while i + 4 <=+ n {
    var b0 = ld8 (key + i);
    st8 out + 2 * i, b0 >>> 4;
    st8 out + 2 * i + 1, b0 & 15;
    var b1 = ld8 (key + i + 1);
    st8 out + 2 * i + 2, b1 >>> 4;
    st8 out + 2 * i + 3, b1 & 15;
    var b2 = ld8 (key + i + 2);
    st8 out + 2 * i + 4, b2 >>> 4;
    st8 out + 2 * i + 5, b2 & 15;
    var b3 = ld8 (key + i + 3);
    st8 out + 2 * i + 6, b3 >>> 4;
    st8 out + 2 * i + 7, b3 & 15;
    i = i + 4;
  }
  while i <+ n {
    var b = ld8 (key + i);
    st8 out + 2 * i, b >>> 4;
    st8 out + 2 * i + 1, b & 15;
    i = i + 1;
  }
  return 0;
}
fun {1,1,1} compact_to_nibbles(1 p, 1 n) {
  if n == 0 {
    mpt_fail(5);
  }
  var c0 = ld8 p;
  var first = c0 >>> 4;
  var is_leaf = (first >>> 1) & 1;
  var odd = first & 1;
  var 1 out = alloc(2 * n);
  var k = 0;
  if odd != 0 {
    st8 out, c0 & 15;
    k = 1;
  }
  key_to_nibbles(p + 1, n - 1, out + k);
  return <out, k + 2 * (n - 1), is_leaf>;
}
fun 1 nibble_list_to_compact(1 nibs, 1 n, 1 is_leaf, 1 dst) {
  var flag = is_leaf * 2;
  var i = 0;
  if (n & 1) == 0 {
    st8 dst, 16 * flag;
  } else {
    st8 dst, 16 * (flag + 1) + (ld8 nibs);
    i = 1;
  }
  var o = 1;
  while i <+ n {
    st8 dst + o, ((ld8 (nibs + i)) << 4) | (ld8 (nibs + i + 1));
    i = i + 2;
    o = o + 1;
  }
  return o;
}
fun 1 common_prefix_length(1 a, 1 al, 1 b, 1 bl) {
  var n = min(al, bl);
  var i = 0;
  while i <+ n {
    if (ld8 (a + i)) != (ld8 (b + i)) {
      return i;
    }
    i = i + 1;
  }
  return n;
}
fun 1 nibbles_concat(1 a, 1 al, 1 b, 1 bl) {
  var 1 out = alloc(al + bl);
  memcpy(out, a, al);
  memcpy(out + al, b, bl);
  return out;
}
fun 1 nodedb_build(1 slice_arr, 1 n) {
  var cap = 4;
  while cap <+ 2 * n + 2 {
    cap = cap * 2;
  }
  var 1 t = htab_new(32, cap);
  var i = 0;
  while i <+ n {
    keccak256((lds 1 ((slice_arr) + (i) * 16)), (lds 1 ((slice_arr) + (i) * 16 + 8)), mpt_hash_scratch);
    htab_set(t, mpt_hash_scratch, slice_arr + i * 16);
    i = i + 1;
  }
  return t;
}
fun {1,1,1} nodedb_lookup(1 db, 1 hash) {
  var {1,1} r = htab_get(db, hash);
  if r.0 == 0 {
    return <0, 0, 0>;
  }
  return <1, lds 1 (r.1), lds 1 (r.1 + 8)>;
}
fun 1 node_new_hashed(1 hash) {
  var 1 nd = alloc(32);
  st nd + 0, 0;
  st nd + 8, 0;
  st nd + 16, 0;
  st nd + 24, hash;
  return nd;
}
fun 1 node_new_leaf(1 nib, 1 nlen, 1 vptr, 1 vlen) {
  var 1 nd = alloc(64);
  st nd + 0, 1;
  st nd + 8, 0;
  st nd + 16, 0;
  st nd + 24, 0;
  st nd + 32, nib;
  st nd + 40, nlen;
  st nd + 48, vptr;
  st nd + 56, vlen;
  return nd;
}
fun 1 node_new_ext(1 nib, 1 nlen, 1 child) {
  var 1 nd = alloc(56);
  st nd + 0, 2;
  st nd + 8, 0;
  st nd + 16, 0;
  st nd + 24, 0;
  st nd + 32, nib;
  st nd + 40, nlen;
  st nd + 48, child;
  return nd;
}
fun 1 node_new_branch() {
  var 1 nd = alloc(176);
  memzero(nd, 176);
  st nd + 0, 3;
  return nd;
}
fun 1 node_invalidate(1 nd) {
  st nd + 8, 0;
  st nd + 16, 0;
  st nd + 24, 0;
  return 0;
}
fun {1,1,1,1} _resolve_step(1 db, 1 p, 1 n) {
  var {1,1,1,1} it = <0, 0, 0, 0>;
  var e = 0;
  try it = rlp_item(p, n)
  catch RlpErr => e {
    mpt_fail(3);
  }
  if it.0 == 0 {
    if it.2 == 0 {
      return <0, 0, 0, 0>;
    }
    if it.2 != 32 {
      mpt_fail(10);
    }
    var {1,1,1} r = nodedb_lookup(db, it.1);
    if r.0 == 0 {
      var 1 hn = node_new_hashed(it.1);
      return <0, hn, 0, 0>;
    }
    return <1, r.1, r.2, it.1>;
  }
  return <1, p, n, 0>;
}
fun {1,1} _decode_step(1 db, 1 p, 1 n) {
  var {1,1,1,1} it = <0, 0, 0, 0>;
  var e = 0;
  try it = rlp_decode_fully(p, n)
  catch RlpErr => e {
    mpt_fail(3);
  }
  if it.0 == 0 {
    if it.2 == 0 {
      return <0, 0>;
    }
    mpt_fail(4);
  }
  var {1,1} sl = rlp_list_to_slices(it.1, it.2);
  var arr = sl.0;
  if sl.1 == 2 {
    var {1,1,1,1} pi = rlp_item((lds 1 ((arr) + (0) * 16)), (lds 1 ((arr) + (0) * 16 + 8)));
    if pi.0 != 0 {
      mpt_fail(5);
    }
    var {1,1,1} cn = compact_to_nibbles(pi.1, pi.2);
    if cn.2 != 0 {
      var {1,1,1,1} vi = rlp_item((lds 1 ((arr) + (1) * 16)), (lds 1 ((arr) + (1) * 16 + 8)));
      if vi.0 != 0 {
        mpt_fail(6);
      }
      var 1 lf = node_new_leaf(cn.0, cn.1, vi.1, vi.2);
      st lf + 8, p;
      st lf + 16, n;
      return <0, lf>;
    }
    if cn.1 == 0 {
      mpt_fail(7);
    }
    var 1 rec = scratch_alloc(88);
    st rec + 8, 1;
    st rec + 24, arr;
    st rec + 48, p;
    st rec + 56, n;
    st rec + 64, cn.0;
    st rec + 72, cn.1;
    return <1, rec>;
  }
  if sl.1 != 17 {
    mpt_fail(4);
  }
  var 1 br = node_new_branch();
  var 1 rec2 = scratch_alloc(88);
  st rec2 + 8, 2;
  st rec2 + 16, br;
  st rec2 + 24, arr;
  st rec2 + 32, 0;
  st rec2 + 40, 0;
  st rec2 + 48, p;
  st rec2 + 56, n;
  return <1, rec2>;
}
fun 1 _decode_witness_node_body(1 db, 1 p, 1 n) {
  var top = 0;
  var result = 0;
  var cur_p = p;
  var cur_n = n;
  var mode = 1;
  var slot = 0;
  var go = 1;
  while go != 0 {
    if mode == 1 {
      var {1,1} d = _decode_step(db, cur_p, cur_n);
      if d.0 == 0 {
        result = d.1;
        mode = 0;
      } else {
        st d.1 + 0, top;
        top = d.1;
        if (lds 1 (top + 8)) == 1 {
          slot = 1;
        } else {
          slot = 0;
        }
        mode = 2;
      }
    } else {
      if mode == 2 {
        var arr = lds 1 (top + 24);
        var {1,1,1,1} r = _resolve_step(db, (lds 1 ((arr) + (slot) * 16)), (lds 1 ((arr) + (slot) * 16 + 8)));
        if r.0 == 0 {
          st top + 80, 0;
          result = r.1;
          mode = 0;
        } else {
          st top + 80, r.3;
          cur_p = r.1;
          cur_n = r.2;
          mode = 1;
        }
      } else {
        if top == 0 {
          go = 0;
        } else {
          var hash = lds 1 (top + 80);
          if (hash != 0) && (result != 0) {
            st result + 24, hash;
          }
          if (lds 1 (top + 8)) == 1 {
            if result == 0 {
              mpt_fail(8);
            }
            var ck = lds 1 (result + 0);
            if (ck != 3) && (ck != 0) {
              mpt_fail(8);
            }
            var 1 ex = node_new_ext(lds 1 (top + 64), lds 1 (top + 72), result);
            st ex + 8, lds 1 (top + 48);
            st ex + 16, lds 1 (top + 56);
            top = lds 1 (top + 0);
            result = ex;
          } else {
            var br = lds 1 (top + 16);
            var i = lds 1 (top + 32);
            st br + 32 + i * 8, result;
            if result != 0 {
              st top + 40, (lds 1 (top + 40)) + 1;
            }
            i = i + 1;
            if i < 16 {
              st top + 32, i;
              slot = i;
              mode = 2;
            } else {
              var arr2 = lds 1 (top + 24);
              var {1,1,1,1} bv = rlp_item((lds 1 ((arr2) + (16) * 16)), (lds 1 ((arr2) + (16) * 16 + 8)));
              var occ = lds 1 (top + 40);
              if bv.0 == 0 {
                st br + 160, bv.1;
                st br + 168, bv.2;
                if bv.2 != 0 {
                  occ = occ + 1;
                }
              }
              if occ <+ 2 {
                mpt_fail(9);
              }
              st br + 8, lds 1 (top + 48);
              st br + 16, lds 1 (top + 56);
              top = lds 1 (top + 0);
              result = br;
            }
          }
        }
      }
    }
  }
  return result;
}
fun 1 _decode_witness_node_mpt(1 db, 1 p, 1 n, 1 mark) {
  var e = 0;
  var nd = 0;
  try nd = _decode_witness_node_body(db, p, n)
  catch MptErr => e {
    scratch_release(mark);
    throw MptErr e;
  }
  return nd;
}
fun 1 _decode_witness_node(1 db, 1 p, 1 n) {
  var 1 mark = scratch_mark();
  var e = 0;
  var nd = 0;
  try nd = _decode_witness_node_mpt(db, p, n, mark)
  catch RlpErr => e {
    scratch_release(mark);
    throw RlpErr e;
  }
  scratch_release(mark);
  return nd;
}
fun 1 decode_witness_to_mpt(1 db, 1 root_hash) {
  var 1 is_empty = memeq(root_hash, empty_trie_root, 32);
  if is_empty != 0 {
    return 0;
  }
  var {1,1,1} r = nodedb_lookup(db, root_hash);
  if r.0 == 0 {
    mpt_fail(1);
  }
  var 1 nd = _decode_witness_node(db, r.1, r.2);
  if nd != 0 {
    var 1 h = alloc(32);
    memcpy(h, root_hash, 32);
    st nd + 24, h;
  }
  return nd;
}
fun {1,1,1} trie_walk(1 node, 1 nibs, 1 nlen) {
  var pos = 0;
  while node != 0 {
    var k = lds 1 (node + 0);
    if k == 0 {
      mpt_fail(2);
    }
    if k == 1 {
      var rl = lds 1 (node + 40);
      if rl == nlen - pos {
        var 1 eq = memeq(lds 1 (node + 32), nibs + pos, rl);
        if eq != 0 {
          return <1, lds 1 (node + 48), lds 1 (node + 56)>;
        }
      }
      return <0, 0, 0>;
    }
    if k == 2 {
      var sl = lds 1 (node + 40);
      if sl >+ nlen - pos {
        return <0, 0, 0>;
      }
      var 1 eq2 = memeq(lds 1 (node + 32), nibs + pos, sl);
      if eq2 == 0 {
        return <0, 0, 0>;
      }
      pos = pos + sl;
      node = lds 1 (node + 48);
    } else {
      if pos == nlen {
        var vl = lds 1 (node + 168);
        if vl == 0 {
          return <0, 0, 0>;
        }
        return <1, lds 1 (node + 160), vl>;
      }
      node = (lds 1 ((node) + 32 + (ld8 (nibs + pos)) * 8));
      pos = pos + 1;
    }
  }
  return <0, 0, 0>;
}
fun {1,1,1} trie_lookup(1 root, 1 key_hash32) {
  key_to_nibbles(key_hash32, 32, mpt_nib_scratch);
  return trie_walk(root, mpt_nib_scratch, 64);
}
fun 1 mpt_new(1 root_node, 1 secured) {
  var 1 m = alloc(16);
  st m + 0, root_node;
  st m + 8, secured;
  return m;
}
fun 1 mpt_from_witness(1 db, 1 root_hash, 1 secured) {
  var 1 root = decode_witness_to_mpt(db, root_hash);
  return mpt_new(root, secured);
}
fun {1,1} mpt_nibble_key(1 m, 1 key, 1 klen) {
  if (lds 1 (m + 8)) != 0 {
    keccak256(key, klen, mpt_hash_scratch);
    var 1 nb = alloc(64);
    key_to_nibbles(mpt_hash_scratch, 32, nb);
    return <nb, 64>;
  }
  var 1 nb2 = alloc(2 * klen);
  key_to_nibbles(key, klen, nb2);
  return <nb2, 2 * klen>;
}
fun {1,1,1} mpt_get(1 m, 1 key, 1 klen) {
  var 1 mark = heap_mark();
  var {1,1} nk = mpt_nibble_key(m, key, klen);
  var {1,1,1} r = trie_walk(lds 1 (m + 0), nk.0, nk.1);
  heap_release(mark);
  return r;
}
fun 1 _create_branch_from_two_leaves(1 k1, 1 l1, 1 v1, 1 vl1, 1 k2, 1 l2, 1 v2, 1 vl2) {
  var 1 br = node_new_branch();
  if l1 == 0 {
    st br + 160, v1;
    st br + 168, vl1;
  } else {
    var 1 lf1 = node_new_leaf(k1 + 1, l1 - 1, v1, vl1);
    st br + 32 + (ld8 k1) * 8, lf1;
  }
  if l2 == 0 {
    st br + 160, v2;
    st br + 168, vl2;
  } else {
    var 1 lf2 = node_new_leaf(k2 + 1, l2 - 1, v2, vl2);
    st br + 32 + (ld8 k2) * 8, lf2;
  }
  return br;
}
fun 1 _insert_into_leaf(1 node, 1 rk, 1 rl, 1 vptr, 1 vlen) {
  var ek = lds 1 (node + 32);
  var el = lds 1 (node + 40);
  if el == rl {
    var 1 eq = memeq(ek, rk, el);
    if eq != 0 {
      st node + 48, vptr;
      st node + 56, vlen;
      return node;
    }
  }
  var 1 pl = common_prefix_length(ek, el, rk, rl);
  var 1 br = _create_branch_from_two_leaves(ek + pl, el - pl, lds 1 (node + 48), lds 1 (node + 56), rk + pl, rl - pl, vptr, vlen);
  if pl >+ 0 {
    return node_new_ext(ek, pl, br);
  }
  return br;
}
fun 1 _split_extension(1 node, 1 rk, 1 rl, 1 vptr, 1 vlen, 1 pl) {
  var seg = lds 1 (node + 32);
  var sl = lds 1 (node + 40);
  var child = lds 1 (node + 48);
  var 1 br = node_new_branch();
  var sal = sl - pl;
  if sal == 1 {
    st br + 32 + (ld8 (seg + pl)) * 8, child;
  }
  if sal >+ 1 {
    var 1 ex = node_new_ext(seg + pl + 1, sal - 1, child);
    st br + 32 + (ld8 (seg + pl)) * 8, ex;
  }
  var kal = rl - pl;
  if kal == 0 {
    st br + 160, vptr;
    st br + 168, vlen;
  } else {
    var idx = ld8 (rk + pl);
    if (lds 1 ((br) + 32 + (idx) * 8)) != 0 {
      mpt_fail(11);
    }
    var 1 lf = node_new_leaf(rk + pl + 1, kal - 1, vptr, vlen);
    st br + 32 + idx * 8, lf;
  }
  return br;
}
fun 1 _mpt_insert_node(1 node, 1 key, 1 klen, 1 level, 1 vptr, 1 vlen) {
  var result = 0;
  var slot = 0;
  var go = 1;
  while go != 0 {
    var r = 0;
    var next_node = 0;
    var next_slot = 0;
    var next_level = 0;
    go = 0;
    if node == 0 {
      r = node_new_leaf(key + level, klen - level, vptr, vlen);
    } else {
      var k = lds 1 (node + 0);
      if k == 0 {
        mpt_fail(2);
      }
      node_invalidate(node);
      if k == 1 {
        r = _insert_into_leaf(node, key + level, klen - level, vptr, vlen);
      } else {
        if k == 2 {
          var seg = lds 1 (node + 32);
          var sl = lds 1 (node + 40);
          var 1 pl = common_prefix_length(seg, sl, key + level, klen - level);
          if pl == sl {
            r = node;
            next_node = lds 1 (node + 48);
            next_slot = node + 48;
            next_level = level + pl;
            go = 1;
          } else {
            var 1 br = _split_extension(node, key + level, klen - level, vptr, vlen, pl);
            if pl >+ 0 {
              r = node_new_ext(seg, pl, br);
            } else {
              r = br;
            }
          }
        } else {
          if level == klen {
            st node + 160, vptr;
            st node + 168, vlen;
            r = node;
          } else {
            var idx = ld8 (key + level);
            r = node;
            next_node = (lds 1 ((node) + 32 + (idx) * 8));
            next_slot = node + 32 + idx * 8;
            next_level = level + 1;
            go = 1;
          }
        }
      }
    }
    if slot == 0 {
      result = r;
    } else {
      st slot, r;
    }
    node = next_node;
    slot = next_slot;
    level = next_level;
  }
  return result;
}
fun 1 _collapse_branch(1 node) {
  var count = 0;
  var idx = 0;
  var i = 0;
  while i < 16 {
    if (lds 1 ((node) + 32 + (i) * 8)) != 0 {
      count = count + 1;
      idx = i;
    }
    i = i + 1;
  }
  var vl = lds 1 (node + 168);
  if count == 0 {
    if vl == 0 {
      mpt_fail(12);
    }
    return node_new_leaf(node, 0, lds 1 (node + 160), vl);
  }
  if (count == 1) && (vl == 0) {
    var child = (lds 1 ((node) + 32 + (idx) * 8));
    var ck = lds 1 (child + 0);
    if ck == 0 {
      mpt_fail(2);
    }
    var 1 nib = alloc(8);
    st8 nib, idx;
    if ck == 3 {
      return node_new_ext(nib, 1, child);
    }
    var 1 cat = nibbles_concat(nib, 1, lds 1 (child + 32), lds 1 (child + 40));
    if ck == 1 {
      return node_new_leaf(cat, 1 + (lds 1 (child + 40)), lds 1 (child + 48), lds 1 (child + 56));
    }
    return node_new_ext(cat, 1 + (lds 1 (child + 40)), lds 1 (child + 48));
  }
  return node;
}
fun 1 _delete_ext_finish(1 node, 1 seg, 1 sl, 1 nc) {
  if nc == 0 {
    return 0;
  }
  var ck = lds 1 (nc + 0);
  if ck == 3 {
    st node + 48, nc;
    return node;
  }
  if ck == 0 {
    mpt_fail(2);
  }
  var 1 cat = nibbles_concat(seg, sl, lds 1 (nc + 32), lds 1 (nc + 40));
  var cl = sl + (lds 1 (nc + 40));
  if ck == 2 {
    return node_new_ext(cat, cl, lds 1 (nc + 48));
  }
  return node_new_leaf(cat, cl, lds 1 (nc + 48), lds 1 (nc + 56));
}
fun 1 _mpt_delete_node_body(1 node, 1 key, 1 klen, 1 level) {
  var top = 0;
  var res = 0;
  var go = 1;
  while go != 0 {
    go = 0;
    if node == 0 {
      res = 0;
    } else {
      var k = lds 1 (node + 0);
      if k == 0 {
        mpt_fail(2);
      }
      node_invalidate(node);
      if k == 1 {
        res = node;
        if (lds 1 (node + 40)) == klen - level {
          var 1 eq = memeq(lds 1 (node + 32), key + level, klen - level);
          if eq != 0 {
            res = 0;
          }
        }
      } else {
        if k == 2 {
          var seg = lds 1 (node + 32);
          var sl = lds 1 (node + 40);
          var 1 pl = common_prefix_length(seg, sl, key + level, klen - level);
          if pl <+ sl {
            res = node;
          } else {
            var 1 fr = scratch_alloc(40);
            st fr + 0, top;
            st fr + 8, node;
            st fr + 16, 2;
            st fr + 24, seg;
            st fr + 32, sl;
            top = fr;
            node = lds 1 (node + 48);
            level = level + sl;
            go = 1;
          }
        } else {
          if level == klen {
            if (lds 1 (node + 168)) == 0 {
              res = node;
            } else {
              st node + 160, 0;
              st node + 168, 0;
              res = _collapse_branch(node);
            }
          } else {
            var idx = ld8 (key + level);
            var 1 fr2 = scratch_alloc(40);
            st fr2 + 0, top;
            st fr2 + 8, node;
            st fr2 + 16, 3;
            st fr2 + 32, idx;
            top = fr2;
            node = (lds 1 ((node) + 32 + (idx) * 8));
            level = level + 1;
            go = 1;
          }
        }
      }
    }
  }
  while top != 0 {
    var fnode = lds 1 (top + 8);
    if (lds 1 (top + 16)) == 2 {
      res = _delete_ext_finish(fnode, lds 1 (top + 24), lds 1 (top + 32), res);
    } else {
      st fnode + 32 + (lds 1 (top + 32)) * 8, res;
      res = _collapse_branch(fnode);
    }
    top = lds 1 (top + 0);
  }
  return res;
}
fun 1 _mpt_delete_node(1 node, 1 key, 1 klen, 1 level) {
  var 1 mark = scratch_mark();
  var e = 0;
  var res = 0;
  try res = _mpt_delete_node_body(node, key, klen, level)
  catch MptErr => e {
    scratch_release(mark);
    throw MptErr e;
  }
  scratch_release(mark);
  return res;
}
fun 1 mpt_set(1 m, 1 key, 1 klen, 1 vptr, 1 vlen) {
  var {1,1} nk = mpt_nibble_key(m, key, klen);
  var root = lds 1 (m + 0);
  if (vptr == 0) || (vlen == 0) {
    root = _mpt_delete_node(root, nk.0, nk.1, 0);
  } else {
    root = _mpt_insert_node(root, nk.0, nk.1, 0, vptr, vlen);
  }
  st m + 0, root;
  return 0;
}
fun 1 _node_rlp_begin(1 fr, 1 node) {
  var k = lds 1 (node + 0);
  var payload = 0;
  var cbuf = 0;
  var clen = 0;
  if k != 3 {
    var nlen = lds 1 (node + 40);
    cbuf = alloc((nlen >>> 1) + 2);
    var isl = 0;
    if k == 1 {
      isl = 1;
    }
    clen = nibble_list_to_compact(lds 1 (node + 32), nlen, isl, cbuf);
    var 1 el = rlp_bytes_encoded_len(ld8 cbuf, clen);
    payload = el;
    if k == 1 {
      var 1 vl = rlp_value_encoded_len(lds 1 (node + 48), lds 1 (node + 56));
      payload = payload + vl;
    }
  }
  st fr + 24, cbuf;
  st fr + 32, clen;
  st fr + 40, payload;
  return 0;
}
fun 1 _node_rlp_finish(1 fr, 1 node) {
  var k = lds 1 (node + 0);
  var payload = lds 1 (fr + 40);
  var cbuf = lds 1 (fr + 24);
  var clen = lds 1 (fr + 32);
  if k == 2 {
    var 1 rl = node_ref_len(lds 1 (node + 48));
    payload = payload + rl;
  }
  if k == 3 {
    var i = 0;
    while i < 16 {
      var 1 rl2 = node_ref_len((lds 1 ((node) + 32 + (i) * 8)));
      payload = payload + rl2;
      i = i + 1;
    }
    var 1 vl2 = rlp_value_encoded_len(lds 1 (node + 160), lds 1 (node + 168));
    payload = payload + vl2;
  }
  var 1 hl = rlp_list_header_len(payload);
  var 1 buf = alloc(hl + payload);
  rlp_encode_list_header(buf, payload);
  var off = hl;
  if k != 3 {
    var 1 w = rlp_encode_bytes(buf + off, cbuf, clen);
    off = off + w;
    if k == 1 {
      var 1 w2 = rlp_encode_bytes(buf + off, lds 1 (node + 48), lds 1 (node + 56));
      off = off + w2;
    } else {
      var 1 w3 = node_write_ref(lds 1 (node + 48), buf + off);
      off = off + w3;
    }
  } else {
    var j = 0;
    while j < 16 {
      var 1 w4 = node_write_ref((lds 1 ((node) + 32 + (j) * 8)), buf + off);
      off = off + w4;
      j = j + 1;
    }
    var 1 w5 = rlp_encode_bytes(buf + off, lds 1 (node + 160), lds 1 (node + 168));
    off = off + w5;
  }
  st node + 8, buf;
  st node + 16, off;
  return 0;
}
fun 1 _node_needs_rlp(1 child) {
  if child == 0 {
    return 0;
  }
  if (lds 1 (child + 0)) == 0 {
    return 0;
  }
  if (lds 1 (child + 8)) != 0 {
    return 0;
  }
  return 1;
}
fun 1 _node_rlp_fill(1 node) {
  var 1 mark = scratch_mark();
  var 1 fr = scratch_alloc(48);
  st fr + 0, 0;
  st fr + 8, node;
  st fr + 16, 0;
  _node_rlp_begin(fr, node);
  var top = fr;
  while top != 0 {
    var nd = lds 1 (top + 8);
    var k = lds 1 (nd + 0);
    var child = 0;
    var found = 0;
    if k == 2 {
      if (lds 1 (top + 16)) == 0 {
        st top + 16, 1;
        child = lds 1 (nd + 48);
        found = _node_needs_rlp(child);
      }
    } else {
      if k == 3 {
        var i = lds 1 (top + 16);
        while (i < 16) && (found == 0) {
          child = (lds 1 ((nd) + 32 + (i) * 8));
          i = i + 1;
          found = _node_needs_rlp(child);
        }
        st top + 16, i;
      }
    }
    if found != 0 {
      var 1 cf = scratch_alloc(48);
      st cf + 0, top;
      st cf + 8, child;
      st cf + 16, 0;
      _node_rlp_begin(cf, child);
      top = cf;
    } else {
      _node_rlp_finish(top, nd);
      top = lds 1 (top + 0);
    }
  }
  scratch_release(mark);
  return 0;
}
fun {1,1} node_rlp(1 node) {
  var cached = lds 1 (node + 8);
  if cached != 0 {
    return <cached, lds 1 (node + 16)>;
  }
  if (lds 1 (node + 0)) == 0 {
    mpt_fail(2);
  }
  _node_rlp_fill(node);
  return <lds 1 (node + 8), lds 1 (node + 16)>;
}
fun 1 rlp_value_encoded_len(1 p, 1 n) {
  var fb = 0;
  if n >+ 0 {
    fb = ld8 p;
  }
  return rlp_bytes_encoded_len(fb, n);
}
fun 1 node_ref_len(1 child) {
  if child == 0 {
    return 1;
  }
  if (lds 1 (child + 0)) == 0 {
    return 33;
  }
  if (lds 1 (child + 8)) == 0 {
    mpt_fail(13);
  }
  var rl = lds 1 (child + 16);
  if rl <+ 32 {
    return rl;
  }
  return 33;
}
fun 1 node_hash_cached(1 node) {
  var cached = lds 1 (node + 24);
  if cached != 0 {
    return cached;
  }
  if (lds 1 (node + 8)) == 0 {
    mpt_fail(13);
  }
  var 1 h = alloc(32);
  keccak256(lds 1 (node + 8), lds 1 (node + 16), h);
  st node + 24, h;
  return h;
}
fun 1 node_write_ref(1 child, 1 dst) {
  if child == 0 {
    st8 dst, 128;
    return 1;
  }
  if (lds 1 (child + 0)) == 0 {
    st8 dst, 160;
    memcpy(dst + 1, lds 1 (child + 24), 32);
    return 33;
  }
  if (lds 1 (child + 8)) == 0 {
    mpt_fail(13);
  }
  var rp = lds 1 (child + 8);
  var rl = lds 1 (child + 16);
  if rl <+ 32 {
    memcpy(dst, rp, rl);
    return rl;
  }
  var 1 h = node_hash_cached(child);
  st8 dst, 160;
  memcpy(dst + 1, h, 32);
  return 33;
}
fun 1 node_hash(1 node) {
  var cached = lds 1 (node + 24);
  if cached != 0 {
    return cached;
  }
  var {1,1} r = node_rlp(node);
  var 1 h = alloc(32);
  keccak256(r.0, r.1, h);
  st node + 24, h;
  return h;
}
fun 1 mpt_root(1 m, 1 out) {
  var root = lds 1 (m + 0);
  if root == 0 {
    memcpy(out, empty_trie_root, 32);
    return 0;
  }
  var 1 h = node_hash(root);
  memcpy(out, h, 32);
  return 0;
}
fun 1 build_mpt_indexed(1 slice_arr, 1 n, 1 out) {
  var 1 mark = heap_mark();
  var 1 m = mpt_new(0, 0);
  var i = 0;
  while i <+ n {
    var 1 klen = rlp_encode_word(mpt_key_scratch, i);
    mpt_set(m, mpt_key_scratch, klen, (lds 1 ((slice_arr) + (i) * 16)), (lds 1 ((slice_arr) + (i) * 16 + 8)));
    i = i + 1;
  }
  mpt_root(m, out);
  heap_release(mark);
  return 0;
}
fun 1 decode_account_from_leaf(1 p, 1 n, 1 acct_out) {
  var {1,1,1,1} it = <0, 0, 0, 0>;
  var e = 0;
  try it = rlp_decode_fully(p, n)
  catch RlpErr => e {
    mpt_fail(20);
  }
  if it.0 != 1 {
    mpt_fail(20);
  }
  var {1,1} sl = rlp_list_to_slices(it.1, it.2);
  if sl.1 != 4 {
    mpt_fail(20);
  }
  var arr = sl.0;
  var {1,1,1,1} f0 = rlp_item((lds 1 ((arr) + (0) * 16)), (lds 1 ((arr) + (0) * 16 + 8)));
  var {1,1,1,1} f1 = rlp_item((lds 1 ((arr) + (1) * 16)), (lds 1 ((arr) + (1) * 16 + 8)));
  var {1,1,1,1} f2 = rlp_item((lds 1 ((arr) + (2) * 16)), (lds 1 ((arr) + (2) * 16 + 8)));
  var {1,1,1,1} f3 = rlp_item((lds 1 ((arr) + (3) * 16)), (lds 1 ((arr) + (3) * 16 + 8)));
  if (f0.0 | f1.0 | f2.0 | f3.0) != 0 {
    mpt_fail(20);
  }
  if f0.2 >+ 8 {
    mpt_fail(21);
  }
  var nonce = 0;
  var i = 0;
  while i <+ f0.2 {
    nonce = (nonce << 8) | (ld8 (f0.1 + i));
    i = i + 1;
  }
  st acct_out + 0, nonce;
  if f1.2 >+ 32 {
    mpt_fail(22);
  }
  memzero(acct_out + 8, 32);
  i = 0;
  while i <+ f1.2 {
    var pos = f1.2 - 1 - i;
    var lp = acct_out + 8 + (pos >>> 3) * 8;
    st lp, (lds 1 lp) | ((ld8 (f1.1 + i)) << ((pos & 7) * 8));
    i = i + 1;
  }
  if f2.2 == 0 {
    st acct_out + 40, empty_trie_root;
  } else {
    if f2.2 != 32 {
      mpt_fail(23);
    }
    st acct_out + 40, f2.1;
  }
  if f3.2 == 0 {
    st acct_out + 48, empty_code_hash;
  } else {
    if f3.2 != 32 {
      mpt_fail(24);
    }
    st acct_out + 48, f3.1;
  }
  return 0;
}
fun 1 encode_account(1 nonce, {1,1,1,1} balance, 1 storage_root, 1 code_hash, 1 out) {
  var off = 2;
  var 1 w = rlp_encode_word(out + off, nonce);
  off = off + w;
  st_be64(mpt_hash_scratch, balance.3);
  st_be64(mpt_hash_scratch + 8, balance.2);
  st_be64(mpt_hash_scratch + 16, balance.1);
  st_be64(mpt_hash_scratch + 24, balance.0);
  var z = 0;
  while z <+ 32 {
    if (ld8 (mpt_hash_scratch + z)) != 0 {
      break;
    }
    z = z + 1;
  }
  var 1 wb = rlp_encode_bytes(out + off, mpt_hash_scratch + z, 32 - z);
  off = off + wb;
  var 1 wsl = rlp_encode_bytes(out + off, storage_root, 32);
  off = off + wsl;
  var 1 wc = rlp_encode_bytes(out + off, code_hash, 32);
  off = off + wc;
  st8 out, 248;
  st8 out + 1, off - 2;
  return off;
}
exception TxErr : 1;
fun {1,1} tx_scalar_item(1 arr, 1 i, 1 maxb) {
  var {1,1,1,1} it = rlp_item((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)));
  if it.0 != 0 {
    throw TxErr 10;
  }
  if it.2 >+ 0 {
    if (ld8 (it.1)) == 0 {
      throw TxErr 11;
    }
  }
  if maxb != 0 {
    if it.2 >+ maxb {
      throw TxErr 12;
    }
  }
  return <it.1, it.2>;
}
fun {1,1,1,1} tx_scalar_u256(1 arr, 1 i, 1 maxb) {
  var {1,1} f = tx_scalar_item(arr, i, maxb);
  if f.1 >+ 32 {
    throw TxErr 13;
  }
  return u256_from_be(f.0, f.1);
}
fun 1 tx_scalar_word(1 arr, 1 i, 1 maxb, 1 envcode) {
  var {1,1} f = tx_scalar_item(arr, i, maxb);
  if f.1 >+ 8 {
    throw TxErr envcode;
  }
  var v = 0;
  var j = 0;
  while j <+ f.1 {
    v = (v << 8) | (ld8 (f.0 + j));
    j = j + 1;
  }
  return v;
}
fun {1,1} tx_bytes_item(1 arr, 1 i) {
  var {1,1,1,1} it = rlp_item((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)));
  if it.0 != 0 {
    throw TxErr 15;
  }
  return <it.1, it.2>;
}
fun 1 tx_fixed_bytes(1 arr, 1 i, 1 width) {
  var {1,1,1,1} it = rlp_item((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)));
  if it.0 != 0 {
    throw TxErr 15;
  }
  if it.2 != width {
    throw TxErr 16;
  }
  return it.1;
}
fun 1 tx_to_item(1 arr, 1 i) {
  var {1,1,1,1} it = rlp_item((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)));
  if it.0 != 0 {
    throw TxErr 17;
  }
  if it.2 == 0 {
    return 0;
  }
  if it.2 != 20 {
    throw TxErr 17;
  }
  return it.1;
}
fun {1,1} tx_list_item(1 arr, 1 i) {
  var {1,1,1,1} it = rlp_item((lds 1 ((arr) + (i) * 16)), (lds 1 ((arr) + (i) * 16 + 8)));
  if it.0 != 1 {
    throw TxErr 18;
  }
  return <it.1, it.2>;
}
fun {1,1} decode_access_list(1 p, 1 len) {
  var {1,1} lst = rlp_list_to_slices(p, len);
  var 1 recs = alloc(lst.1 * 24);
  var i = 0;
  while i <+ lst.1 {
    var {1,1,1,1} it = rlp_item((lds 1 ((lst.0) + (i) * 16)), (lds 1 ((lst.0) + (i) * 16 + 8)));
    if it.0 != 1 {
      throw TxErr 19;
    }
    var {1,1} ent = rlp_list_to_slices(it.1, it.2);
    if ent.1 != 2 {
      throw TxErr 19;
    }
    var 1 addr = tx_fixed_bytes(ent.0, 0, 20);
    var {1,1} sl = tx_list_item(ent.0, 1);
    var {1,1} slots = rlp_list_to_slices(sl.0, sl.1);
    var 1 keys = alloc(slots.1 * 32);
    var j = 0;
    while j <+ slots.1 {
      var 1 k = tx_fixed_bytes(slots.0, j, 32);
      memcpy(keys + j * 32, k, 32);
      j = j + 1;
    }
    var rec = recs + i * 24;
    st rec + 0, addr;
    st rec + 8, keys;
    st rec + 16, slots.1;
    i = i + 1;
  }
  return <recs, lst.1>;
}
fun {1,1} decode_blob_hashes(1 p, 1 len) {
  var {1,1} lst = rlp_list_to_slices(p, len);
  var 1 buf = alloc(lst.1 * 32);
  var i = 0;
  while i <+ lst.1 {
    var 1 h = tx_fixed_bytes(lst.0, i, 32);
    memcpy(buf + i * 32, h, 32);
    i = i + 1;
  }
  return <buf, lst.1>;
}
fun {1,1} decode_authorizations(1 p, 1 len) {
  var {1,1} lst = rlp_list_to_slices(p, len);
  var 1 recs = alloc(lst.1 * 120);
  var i = 0;
  while i <+ lst.1 {
    var {1,1,1,1} it = rlp_item((lds 1 ((lst.0) + (i) * 16)), (lds 1 ((lst.0) + (i) * 16 + 8)));
    if it.0 != 1 {
      throw TxErr 20;
    }
    var {1,1} ent = rlp_list_to_slices(it.1, it.2);
    if ent.1 != 6 {
      throw TxErr 20;
    }
    var a = recs + i * 120;
    var {1,1,1,1} cid = tx_scalar_u256(ent.0, 0, 32);
    st a + 0, cid;
    var 1 addr = tx_fixed_bytes(ent.0, 1, 20);
    st a + 32, addr;
    var 1 w = tx_scalar_word(ent.0, 2, 8, 12);
    st a + 40, w;
    w = tx_scalar_word(ent.0, 3, 1, 12);
    st a + 48, w;
    var {1,1,1,1} r = tx_scalar_u256(ent.0, 4, 32);
    st a + 56, r;
    var {1,1,1,1} s = tx_scalar_u256(ent.0, 5, 32);
    st a + 88, s;
    i = i + 1;
  }
  return <recs, lst.1>;
}
fun 1 decode_transaction_rlp(1 p, 1 len) {
  if len == 0 {
    throw TxErr 1;
  }
  var b0 = ld8 p;
  var 1 tx = alloc(400);
  memzero(tx, 400);
  st tx + 384, p;
  st tx + 392, len;
  var {1,1,1,1} top = <0, 0, 0, 0>;
  var t = 0;
  var nfields = 9;
  if (b0 >=+ 1) && (b0 <=+ 4) {
    top = rlp_decode_fully(p + 1, len - 1);
    t = b0;
    if t == 1 { nfields = 11; }
    if t == 2 { nfields = 12; }
    if t == 3 { nfields = 14; }
    if t == 4 { nfields = 13; }
  } else {
    if (b0 >=+ 192) && (b0 <=+ 254) {
      top = rlp_decode_fully(p, len);
    } else {
      throw TxErr 2;
    }
  }
  st tx + 0, t;
  if top.0 != 1 {
    throw TxErr 3;
  }
  var {1,1} lst = rlp_list_to_slices(top.1, top.2);
  var arr = lst.0;
  if lst.1 != nfields {
    throw TxErr 4;
  }
  var k = 0;
  var 1 w = 0;
  if t != 0 {
    w = tx_scalar_word(arr, 0, 8, 12);
    st tx + 8, w;
    k = 1;
  }
  var {1,1,1,1} v = <0, 0, 0, 0>;
  if t == 4 {
    w = tx_scalar_word(arr, k, 8, 12);
    v = <w, 0, 0, 0>;
  } else {
    v = tx_scalar_u256(arr, k, 32);
  }
  st tx + 16, v;
  k = k + 1;
  if t <=+ 1 {
    v = tx_scalar_u256(arr, k, 0);
    st tx + 48, v;
    k = k + 1;
  } else {
    v = tx_scalar_u256(arr, k, 0);
    st tx + 80, v;
    v = tx_scalar_u256(arr, k + 1, 0);
    st tx + 112, v;
    k = k + 2;
  }
  w = tx_scalar_word(arr, k, 0, 14);
  st tx + 144, w;
  k = k + 1;
  if t >=+ 3 {
    w = tx_fixed_bytes(arr, k, 20);
  } else {
    w = tx_to_item(arr, k);
  }
  st tx + 152, w;
  k = k + 1;
  v = tx_scalar_u256(arr, k, 32);
  st tx + 160, v;
  k = k + 1;
  var {1,1} data = tx_bytes_item(arr, k);
  st tx + 192, data.0;
  st tx + 200, data.1;
  k = k + 1;
  if t != 0 {
    var {1,1} al = tx_list_item(arr, k);
    var {1,1} acc = decode_access_list(al.0, al.1);
    st tx + 208, acc.0;
    st tx + 216, acc.1;
    k = k + 1;
  }
  if t == 3 {
    v = tx_scalar_u256(arr, k, 32);
    st tx + 224, v;
    var {1,1} bl = tx_list_item(arr, k + 1);
    var {1,1} bh = decode_blob_hashes(bl.0, bl.1);
    st tx + 256, bh.0;
    st tx + 264, bh.1;
    k = k + 2;
  }
  if t == 4 {
    var {1,1} aul = tx_list_item(arr, k);
    var {1,1} au = decode_authorizations(aul.0, aul.1);
    st tx + 272, au.0;
    st tx + 280, au.1;
    k = k + 1;
  }
  v = tx_scalar_u256(arr, k, 32);
  st tx + 288, v;
  v = tx_scalar_u256(arr, k + 1, 32);
  st tx + 320, v;
  v = tx_scalar_u256(arr, k + 2, 32);
  st tx + 352, v;
  return tx;
}
fun 1 decode_transaction(1 p, 1 len) {
  var 1 tx = 0;
  var rc = 0;
  try tx = decode_transaction_rlp(p, len)
  catch RlpErr => rc {
    throw TxErr (100 + rc);
  }
  return tx;
}
fun 1 tx_gas(1 tx) {
  return lds 1 (tx + 144);
}
fun {1,1,1,1} tx_nonce(1 tx) {
  return lds {1,1,1,1} (tx + 16);
}
fun 1 tx_to(1 tx) {
  return lds 1 (tx + 152);
}
fun {1,1,1,1} tx_value(1 tx) {
  return lds {1,1,1,1} (tx + 160);
}
fun {1,1} tx_data(1 tx) {
  return <lds 1 (tx + 192), lds 1 (tx + 200)>;
}
fun {1,1,1,1} tx_r(1 tx) {
  return lds {1,1,1,1} (tx + 320);
}
fun {1,1,1,1} tx_s(1 tx) {
  return lds {1,1,1,1} (tx + 352);
}
fun 1 tx_has_access_list(1 tx) {
  if (lds 1 (tx + 0)) != 0 { return 1; }
  return 0;
}
fun 1 tx_blob_count(1 tx) {
  return lds 1 (tx + 264);
}
fun 1 calculate_total_blob_gas(1 tx) {
  return 131072 * (lds 1 (tx + 264));
}
fun 1 tx_put_u256(1 dst, {1,1,1,1} v) {
  var 1 mark = heap_mark();
  var 1 tmp = alloc(32);
  var 1 n = u256_to_be_min(v, tmp);
  var 1 w = rlp_encode_bytes(dst, tmp, n);
  heap_release(mark);
  return w;
}
fun 1 tx_u256_encoded_len({1,1,1,1} v) {
  var 1 n = u256_byte_length(v);
  if n == 0 { return 1; }
  if n == 1 {
    if v.0 <+ 128 { return 1; }
  }
  return 1 + n;
}
fun 1 tx_put_to(1 dst, 1 to) {
  if to == 0 {
    st8 dst, 128;
    return 1;
  }
  return rlp_encode_bytes(dst, to, 20);
}
fun 1 access_list_payload_len(1 recs, 1 n) {
  var total = 0;
  var i = 0;
  while i <+ n {
    var inner = 33 * (lds 1 (recs + i * 24 + 16));
    var 1 ih = rlp_list_header_len(inner);
    var entry = 21 + ih + inner;
    var 1 eh = rlp_list_header_len(entry);
    total = total + eh + entry;
    i = i + 1;
  }
  return total;
}
fun 1 tx_put_access_list(1 dst, 1 recs, 1 n) {
  var 1 pl = access_list_payload_len(recs, n);
  var 1 w = rlp_encode_list_header(dst, pl);
  var p = dst + w;
  var i = 0;
  while i <+ n {
    var rec = recs + i * 24;
    var ns = lds 1 (rec + 16);
    var inner = 33 * ns;
    var 1 ih = rlp_list_header_len(inner);
    w = rlp_encode_list_header(p, 21 + ih + inner);
    p = p + w;
    w = rlp_encode_bytes(p, lds 1 (rec + 0), 20);
    p = p + w;
    w = rlp_encode_list_header(p, inner);
    p = p + w;
    var keys = lds 1 (rec + 8);
    var j = 0;
    while j <+ ns {
      w = rlp_encode_bytes(p, keys + j * 32, 32);
      p = p + w;
      j = j + 1;
    }
    i = i + 1;
  }
  return p - dst;
}
fun 1 tx_put_blob_hashes(1 dst, 1 buf, 1 n) {
  var 1 w = rlp_encode_list_header(dst, 33 * n);
  var p = dst + w;
  var i = 0;
  while i <+ n {
    w = rlp_encode_bytes(p, buf + i * 32, 32);
    p = p + w;
    i = i + 1;
  }
  return p - dst;
}
fun 1 auth_payload_len(1 a) {
  var 1 lc = tx_u256_encoded_len(lds {1,1,1,1} (a + 0));
  var 1 ln = rlp_word_encoded_len(lds 1 (a + 40));
  var 1 ly = rlp_word_encoded_len(lds 1 (a + 48));
  var 1 lr = tx_u256_encoded_len(lds {1,1,1,1} (a + 56));
  var 1 ls = tx_u256_encoded_len(lds {1,1,1,1} (a + 88));
  return lc + 21 + ln + ly + lr + ls;
}
fun 1 auth_list_payload_len(1 recs, 1 n) {
  var total = 0;
  var i = 0;
  while i <+ n {
    var 1 pl = auth_payload_len(recs + i * 120);
    var 1 h = rlp_list_header_len(pl);
    total = total + h + pl;
    i = i + 1;
  }
  return total;
}
fun 1 tx_put_authorizations(1 dst, 1 recs, 1 n) {
  var 1 total = auth_list_payload_len(recs, n);
  var 1 w = rlp_encode_list_header(dst, total);
  var p = dst + w;
  var i = 0;
  while i <+ n {
    var a = recs + i * 120;
    var 1 pl = auth_payload_len(a);
    w = rlp_encode_list_header(p, pl);
    p = p + w;
    w = tx_put_u256(p, lds {1,1,1,1} (a + 0));
    p = p + w;
    w = rlp_encode_bytes(p, lds 1 (a + 32), 20);
    p = p + w;
    w = rlp_encode_word(p, lds 1 (a + 40));
    p = p + w;
    w = rlp_encode_word(p, lds 1 (a + 48));
    p = p + w;
    w = tx_put_u256(p, lds {1,1,1,1} (a + 56));
    p = p + w;
    w = tx_put_u256(p, lds {1,1,1,1} (a + 88));
    p = p + w;
    i = i + 1;
  }
  return p - dst;
}
fun 1 tx_encode_bound(1 tx) {
  var 1 al = access_list_payload_len(lds 1 (tx + 208), lds 1 (tx + 216));
  var 1 au = auth_list_payload_len(lds 1 (tx + 272), lds 1 (tx + 280));
  var bh = 33 * (lds 1 (tx + 264));
  return 64 + 17 * 33 + 30 + (lds 1 (tx + 200)) + al + au + bh;
}
fun {1,1} tx_encode_generic(1 tx, 1 mode, 1 chain_id) {
  var 1 bound = tx_encode_bound(tx);
  var 1 buf = alloc(bound);
  var body = buf + 10;
  var p = body;
  var t = lds 1 (tx + 0);
  var 1 w = 0;
  if t != 0 {
    w = rlp_encode_word(p, lds 1 (tx + 8));
    p = p + w;
  }
  w = tx_put_u256(p, lds {1,1,1,1} (tx + 16));
  p = p + w;
  if t <=+ 1 {
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 48));
    p = p + w;
  } else {
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 80));
    p = p + w;
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 112));
    p = p + w;
  }
  w = rlp_encode_word(p, lds 1 (tx + 144));
  p = p + w;
  w = tx_put_to(p, lds 1 (tx + 152));
  p = p + w;
  w = tx_put_u256(p, lds {1,1,1,1} (tx + 160));
  p = p + w;
  w = rlp_encode_bytes(p, lds 1 (tx + 192), lds 1 (tx + 200));
  p = p + w;
  if t != 0 {
    w = tx_put_access_list(p, lds 1 (tx + 208), lds 1 (tx + 216));
    p = p + w;
  }
  if t == 3 {
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 224));
    p = p + w;
    w = tx_put_blob_hashes(p, lds 1 (tx + 256), lds 1 (tx + 264));
    p = p + w;
  }
  if t == 4 {
    w = tx_put_authorizations(p, lds 1 (tx + 272), lds 1 (tx + 280));
    p = p + w;
  }
  if mode == 0 {
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 288));
    p = p + w;
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 320));
    p = p + w;
    w = tx_put_u256(p, lds {1,1,1,1} (tx + 352));
    p = p + w;
  }
  if mode == 2 {
    w = rlp_encode_word(p, chain_id);
    p = p + w;
    st8 p, 128;
    st8 p + 1, 128;
    p = p + 2;
  }
  var payload_len = p - body;
  var 1 hl = rlp_list_header_len(payload_len);
  var start = body - hl;
  rlp_encode_list_header(start, payload_len);
  if t != 0 {
    start = start - 1;
    st8 start, t;
  }
  return <start, p - start>;
}
fun {1,1} encode_transaction(1 tx) {
  return tx_encode_generic(tx, 0, 0);
}
fun 1 get_transaction_hash(1 tx, 1 out) {
  keccak256(lds 1 (tx + 384), lds 1 (tx + 392), out);
  return 0;
}
fun 1 tx_signing_hash_mode(1 tx, 1 mode, 1 chain_id, 1 out) {
  var 1 mark = heap_mark();
  var {1,1} e = tx_encode_generic(tx, mode, chain_id);
  keccak256(e.0, e.1, out);
  heap_release(mark);
  return 0;
}
fun 1 signing_hash_pre155(1 tx, 1 out) {
  return tx_signing_hash_mode(tx, 1, 0, out);
}
fun 1 signing_hash_155(1 tx, 1 chain_id, 1 out) {
  return tx_signing_hash_mode(tx, 2, chain_id, out);
}
fun 1 signing_hash_2930(1 tx, 1 out) {
  return tx_signing_hash_mode(tx, 1, 0, out);
}
fun 1 signing_hash_1559(1 tx, 1 out) {
  return tx_signing_hash_mode(tx, 1, 0, out);
}
fun 1 signing_hash_4844(1 tx, 1 out) {
  return tx_signing_hash_mode(tx, 1, 0, out);
}
fun 1 signing_hash_7702(1 tx, 1 out) {
  return tx_signing_hash_mode(tx, 1, 0, out);
}
fun {1,1} tx_chain_id(1 tx) {
  if (lds 1 (tx + 0)) != 0 {
    return <1, lds 1 (tx + 8)>;
  }
  var {1,1,1,1} v = lds {1,1,1,1} (tx + 288);
  var 1 fits = u256_fits_word(v);
  if fits != 0 {
    if (v.0 == 27) || (v.0 == 28) {
      return <0, 0>;
    }
    if v.0 <+ 35 {
      throw TxErr 44;
    }
  }
  var {1,1,1,1} vm = u256_sub(v, <35, 0, 0, 0>);
  var {1,1,1,1} sh = u256_shr(vm, 1);
  fits = u256_fits_word(sh);
  if fits == 0 {
    throw TxErr 45;
  }
  return <1, sh.0>;
}
fun 1 signature_recovery_parameters(1 tx, 1 chain_id, 1 out_hash) {
  var {1,1,1,1} r = lds {1,1,1,1} (tx + 320);
  var {1,1,1,1} s = lds {1,1,1,1} (tx + 352);
  var 1 z = u256_is_zero(r);
  if z != 0 {
    throw TxErr 40;
  }
  var 1 lt = u256_lt(r, <-4624529908474429119, -4994812053365940165, -2, -1>);
  if lt == 0 {
    throw TxErr 40;
  }
  z = u256_is_zero(s);
  if z != 0 {
    throw TxErr 41;
  }
  var 1 gt = u256_gt(s, <-2312264954237214560, 6725966010171805725, -1, 9223372036854775807>);
  if gt != 0 {
    throw TxErr 41;
  }
  var t = lds 1 (tx + 0);
  var {1,1,1,1} v = lds {1,1,1,1} (tx + 288);
  var 1 fits = u256_fits_word(v);
  if t == 0 {
    if fits != 0 {
      if (v.0 == 27) || (v.0 == 28) {
        signing_hash_pre155(tx, out_hash);
        return v.0 - 27;
      }
    }
    var {1,1,1,1} c = <chain_id, 0, 0, 0>;
    var {1,1,1,1} x2 = u256_add(c, c);
    var {1,1,1,1} v35 = u256_add(x2, <35, 0, 0, 0>);
    var {1,1,1,1} v36 = u256_add(x2, <36, 0, 0, 0>);
    var 1 eq35 = u256_eq(v, v35);
    var 1 eq36 = u256_eq(v, v36);
    if (eq35 == 0) && (eq36 == 0) {
      throw TxErr 42;
    }
    signing_hash_155(tx, chain_id, out_hash);
    return eq36;
  }
  if fits == 0 {
    throw TxErr 43;
  }
  if v.0 >+ 1 {
    throw TxErr 43;
  }
  if t == 1 { signing_hash_2930(tx, out_hash); }
  if t == 2 { signing_hash_1559(tx, out_hash); }
  if t == 3 { signing_hash_4844(tx, out_hash); }
  if t == 4 { signing_hash_7702(tx, out_hash); }
  return v.0;
}
fun 1 recover_transaction_public_key(1 tx, 1 chain_id, 1 out64) {
  var 1 mark = heap_mark();
  var 1 h = alloc(32);
  var 1 recid = signature_recovery_parameters(tx, chain_id, h);
  var 1 ok = secp256k1_recover(h, lds {1,1,1,1} (tx + 320), lds {1,1,1,1} (tx + 352), recid, out64);
  heap_release(mark);
  if ok == 0 {
    throw TxErr 46;
  }
  return 0;
}
fun 1 sender_address_from_public_key(1 pubkey65, 1 out20) {
  var 1 mark = heap_mark();
  var 1 h = alloc(32);
  keccak256(pubkey65 + 1, 64, h);
  memcpy(out20, h + 12, 20);
  heap_release(mark);
  return 0;
}
fun 1 recover_sender(1 tx, 1 out20) {
  var {1,1} cid = tx_chain_id(tx);
  var 1 mark = heap_mark();
  var 1 pk = alloc(72);
  st8 pk, 4;
  recover_transaction_public_key(tx, cid.1, pk + 1);
  sender_address_from_public_key(pk, out20);
  heap_release(mark);
  return 0;
}
fun 1 recover_sender_with_chain_id(1 tx, 1 chain_id, 1 out20) {
  var 1 mark = heap_mark();
  var 1 pk = alloc(72);
  st8 pk, 4;
  recover_transaction_public_key(tx, chain_id, pk + 1);
  sender_address_from_public_key(pk, out20);
  heap_release(mark);
  return 0;
}
fun 1 count_tokens_in_data(1 p, 1 n) {
  var zeros = 0;
  var i = 0;
  while i <+ n {
    if (ld8 (p + i)) == 0 {
      zeros = zeros + 1;
    }
    i = i + 1;
  }
  return zeros + (n - zeros) * 4;
}
fun {1,1,1} calculate_intrinsic_cost(1 tx, 1 sender) {
  var data = lds 1 (tx + 192);
  var data_n = lds 1 (tx + 200);
  var 1 tokens_in_calldata = count_tokens_in_data(data, data_n);
  var data_cost = tokens_in_calldata * 4;
  var to = lds 1 (tx + 152);
  var 1 value_zero = u256_is_zero(lds {1,1,1,1} (tx + 160));
  var recipient_regular_gas = 0;
  var init_code_gas = 0;
  if to == 0 {
    recipient_regular_gas = 12000;
    init_code_gas = 2 * ((data_n + 31) >>> 5);
  } else {
    var 1 is_self_transfer = memeq(to, sender, 20);
    if is_self_transfer == 0 {
      recipient_regular_gas = 3000;
      if value_zero == 0 {
        recipient_regular_gas = recipient_regular_gas + 6000;
      }
    }
  }
  var access_list_cost = 0;
  var tokens_in_access_list = 0;
  if (lds 1 (tx + 0)) != 0 {
    var recs = lds 1 (tx + 208);
    var n = lds 1 (tx + 216);
    var i = 0;
    while i <+ n {
      var ns = lds 1 (recs + i * 24 + 16);
      access_list_cost = access_list_cost + (3000 - 100) + ns * (2100 - 100);
      tokens_in_access_list = tokens_in_access_list + 80
          + ns * 128;
      i = i + 1;
    }
  }
  access_list_cost = access_list_cost + tokens_in_access_list * 16;
  var auth_regular_gas = 0;
  if (lds 1 (tx + 0)) == 4 {
    auth_regular_gas = 7816 * (lds 1 (tx + 280));
  }
  var floor_tokens_in_calldata = data_n * 4;
  var total_floor_tokens = floor_tokens_in_calldata + tokens_in_access_list;
  var base_regular_gas = 12000 + recipient_regular_gas;
  var regular = base_regular_gas + init_code_gas + data_cost + access_list_cost + auth_regular_gas;
  var floor = total_floor_tokens * 16 + base_regular_gas;
  return <regular, 0, floor>;
}
fun {1,1,1} validate_transaction(1 tx, 1 sender) {
  var {1,1,1} ic = calculate_intrinsic_cost(tx, sender);
  var gas = lds 1 (tx + 144);
  if gas >+ 4294967295 {
    throw TxErr 66;
  }
  if (ic.0 + ic.1) >+ gas {
    throw TxErr 60;
  }
  if ic.2 >+ gas {
    throw TxErr 61;
  }
  if (lds 1 (tx + 152)) == 0 {
    if (lds 1 (tx + 200)) >+ 131072 {
      throw TxErr 62;
    }
  }
  if ic.0 >+ 16777216 {
    throw TxErr 63;
  }
  if ic.2 >+ 16777216 {
    throw TxErr 64;
  }
  var {1,1,1,1} nonce = lds {1,1,1,1} (tx + 16);
  var 1 fits = u256_fits_word(nonce);
  if fits == 0 {
    throw TxErr 65;
  }
  if nonce.0 == (0 - 1) {
    throw TxErr 65;
  }
  return ic;
}
exception StateErr : 1;
var 1 ws = 0;
var 1 bs = 0;
var 1 ts = 0;
var 1 sk_buf = 0;
var 1 journal = 0;
var 1 journal_cap = 0;
fun 1 state_init(1 nodedb, 1 state_root, 1 codedb) {
  ws = alloc(40);
  st ws + 0, nodedb;
  st ws + 8, state_root;
  st ws + 16, codedb;
  var 1 root = decode_witness_to_mpt(nodedb, state_root);
  st ws + 24, root;
  var 1 t = htab_new(32, 64);
  st ws + 32, t;
  bs = alloc(80);
  st bs + 0, ws;
  t = htab_new(20, 256);
  st bs + 8, t;
  t = htab_new(20, 256);
  st bs + 16, t;
  t = htab_new(52, 256);
  st bs + 24, t;
  t = htab_new(20, 64);
  st bs + 32, t;
  t = htab_new(52, 64);
  st bs + 40, t;
  t = htab_new(32, 64);
  st bs + 48, t;
  st bs + 56, 0;
  st bs + 64, 0;
  t = htab_new(20, 256);
  st bs + 72, t;
  sk_buf = alloc(64);
  journal_cap = 524288;
  journal = alloc(journal_cap * 32);
  journal_n = 0;
  ts = 0;
  return 0;
}
fun 1 state_fresh_tx() {
  ts = alloc(72);
  st ts + 0, bs;
  var 1 t = htab_new(20, 64);
  st ts + 8, t;
  t = htab_new(20, 64);
  st ts + 16, t;
  t = htab_new(52, 64);
  st ts + 24, t;
  t = htab_new(20, 16);
  st ts + 32, t;
  t = htab_new(52, 16);
  st ts + 40, t;
  t = htab_new(32, 16);
  st ts + 48, t;
  t = htab_new(20, 16);
  st ts + 56, t;
  t = htab_new(52, 16);
  st ts + 64, t;
  journal_n = 0;
  return 0;
}
fun 1 jset(1 t, 1 key, 1 value) {
  var {1,1} old = htab_get(t, key);
  if journal_n >=+ journal_cap {
    trap_with(4);
  }
  var klen = lds 1 (t + 0);
  var 1 kc = alloc(klen);
  memcpy(kc, key, klen);
  var r = journal + journal_n * 32;
  st r, t;
  st r + 8, kc;
  st r + 16, old.0;
  st r + 24, old.1;
  journal_n = journal_n + 1;
  htab_set(t, key, value);
  return 0;
}
fun 1 jdel(1 t, 1 key) {
  var {1,1} old = htab_get(t, key);
  if old.0 == 0 {
    return 0;
  }
  if journal_n >=+ journal_cap {
    trap_with(5);
  }
  var klen = lds 1 (t + 0);
  var 1 kc = alloc(klen);
  memcpy(kc, key, klen);
  var r = journal + journal_n * 32;
  st r, t;
  st r + 8, kc;
  st r + 16, 1;
  st r + 24, old.1;
  journal_n = journal_n + 1;
  htab_del(t, key);
  return 0;
}
fun 1 state_snapshot() {
  return journal_n;
}
fun 1 state_restore(1 snap) {
  while journal_n >+ snap {
    journal_n = journal_n - 1;
    var r = journal + journal_n * 32;
    var t = lds 1 r;
    var key = lds 1 (r + 8);
    if (lds 1 (r + 16)) != 0 {
      htab_set(t, key, lds 1 (r + 24));
    } else {
      htab_del(t, key);
    }
  }
  return 0;
}
fun 1 sk_make(1 addr, 1 key) {
  memcpy(sk_buf, addr, 20);
  memcpy(sk_buf + 20, key, 32);
  return sk_buf;
}
fun 1 acct_new(1 nonce, {1,1,1,1} balance, 1 code_hash) {
  var 1 a = alloc(56);
  st a + 0, nonce;
  st a + 8, balance;
  st a + 40, empty_trie_root;
  st a + 48, code_hash;
  return a;
}
fun 1 acct_empty() {
  var 1 a = acct_new(0, <0, 0, 0, 0>, empty_code_hash);
  return a;
}
fun 1 acct_copy(1 a) {
  var 1 b = alloc(56);
  memcpy(b, a, 56);
  return b;
}
fun 1 record_pre_state_read(1 addr) {
  htab_set(lds 1 (bs + 72), addr, 1);
  return 0;
}
fun {1,1,1} ws_account_leaf(1 addr) {
  var 1 mark = heap_mark();
  var 1 h = alloc(32);
  keccak256(addr, 20, h);
  var {1,1,1} r = trie_lookup(lds 1 (ws + 24), h);
  heap_release(mark);
  return r;
}
fun 1 ws_get_account_optional(1 addr) {
  var {1,1,1} leaf = ws_account_leaf(addr);
  if leaf.0 == 0 {
    return 1;
  }
  var 1 a = alloc(56);
  decode_account_from_leaf(leaf.1, leaf.2, a);
  return a;
}
fun 1 ws_storage_root_of(1 addr) {
  var 1 a = ws_get_account_optional(addr);
  if a == 1 {
    return empty_trie_root;
  }
  return lds 1 (a + 40);
}
fun 1 ws_storage_trie(1 root) {
  var t = lds 1 (ws + 32);
  var {1,1} m = htab_get(t, root);
  if m.0 != 0 {
    return m.1 - 1;
  }
  var 1 node = decode_witness_to_mpt(lds 1 (ws + 0), root);
  htab_set(t, root, node + 1);
  return node;
}
fun {1,1,1,1} ws_get_storage(1 addr, 1 key) {
  var 1 root = ws_storage_root_of(addr);
  var 1 eq = memeq(root, empty_trie_root, 32);
  if eq != 0 {
    return <0, 0, 0, 0>;
  }
  var 1 node = ws_storage_trie(root);
  var 1 mark = heap_mark();
  var 1 h = alloc(32);
  keccak256(key, 32, h);
  var {1,1,1} r = trie_lookup(node, h);
  heap_release(mark);
  if r.0 == 0 {
    return <0, 0, 0, 0>;
  }
  var {1,1,1,1} it = rlp_decode_fully(r.1, r.2);
  if it.0 == 1 {
    return <0, 0, 0, 0>;
  }
  if it.2 >+ 32 {
    throw StateErr 1;
  }
  var {1,1,1,1} v = u256_from_be(it.1, it.2);
  return v;
}
fun {1,1} ws_get_code(1 code_hash) {
  var 1 eq = memeq(code_hash, empty_code_hash, 32);
  if eq != 0 {
    return <0, 0>;
  }
  var {1,1,1} r = nodedb_lookup(lds 1 (ws + 16), code_hash);
  if r.0 == 0 {
    throw StateErr 2;
  }
  return <r.1, r.2>;
}
fun 1 ws_account_has_storage(1 addr) {
  var 1 root = ws_storage_root_of(addr);
  var 1 eq = memeq(root, empty_trie_root, 32);
  if eq != 0 {
    return 0;
  }
  return 1;
}
fun 1 get_pre_state_account_optional(1 addr) {
  htab_set(lds 1 (ts + 8), addr, 1);
  var {1,1} w = htab_get(lds 1 (bs + 16), addr);
  if w.0 != 0 {
    return w.1;
  }
  record_pre_state_read(addr);
  var 1 a = ws_get_account_optional(addr);
  return a;
}
fun 1 get_pre_state_account(1 addr) {
  var 1 a = get_pre_state_account_optional(addr);
  if a == 1 {
    a = acct_empty();
  }
  return a;
}
fun 1 get_account_optional(1 addr) {
  htab_set(lds 1 (ts + 8), addr, 1);
  var {1,1} w = htab_get(lds 1 (ts + 16), addr);
  if w.0 != 0 {
    return w.1;
  }
  var 1 a = get_pre_state_account_optional(addr);
  return a;
}
fun 1 get_account(1 addr) {
  var 1 a = get_account_optional(addr);
  if a == 1 {
    a = acct_empty();
  }
  return a;
}
fun {1,1} get_code(1 code_hash, 1 addr) {
  var 1 eq = memeq(code_hash, empty_code_hash, 32);
  if eq != 0 {
    return <0, 0>;
  }
  var {1,1} w = htab_get(lds 1 (ts + 48), code_hash);
  if w.0 != 0 {
    return <lds 1 (w.1), lds 1 (w.1 + 8)>;
  }
  w = htab_get(lds 1 (bs + 48), code_hash);
  if w.0 != 0 {
    return <lds 1 (w.1), lds 1 (w.1 + 8)>;
  }
  var 1 k = sk_make(addr, code_hash);
  htab_set(lds 1 (ts + 40), k, 1);
  var {1,1} c = ws_get_code(code_hash);
  return c;
}
fun {1,1} stor_lookup(1 outer, 1 addr, 1 key) {
  var {1,1} m = htab_get(outer, addr);
  if m.0 == 0 {
    return <0, 0>;
  }
  var {1,1} v = htab_get(m.1, key);
  return v;
}
fun {1,1,1,1} get_storage(1 addr, 1 key) {
  var 1 k = sk_make(addr, key);
  htab_set(lds 1 (ts + 24), k, 1);
  var {1,1} v = stor_lookup(lds 1 (ts + 32), addr, key);
  if v.0 != 0 {
    return lds {1,1,1,1} (v.1);
  }
  v = stor_lookup(lds 1 (bs + 32), addr, key);
  if v.0 != 0 {
    return lds {1,1,1,1} (v.1);
  }
  record_pre_state_read(addr);
  var {1,1,1,1} r = ws_get_storage(addr, key);
  return r;
}
fun {1,1,1,1} get_storage_original(1 addr, 1 key) {
  var 1 created = htab_has(lds 1 (ts + 56), addr);
  if created != 0 {
    return <0, 0, 0, 0>;
  }
  var {1,1} v = stor_lookup(lds 1 (bs + 32), addr, key);
  if v.0 != 0 {
    return lds {1,1,1,1} (v.1);
  }
  record_pre_state_read(addr);
  var {1,1,1,1} r = ws_get_storage(addr, key);
  return r;
}
fun {1,1,1,1} get_transient_storage(1 addr, 1 key) {
  var 1 k = sk_make(addr, key);
  var {1,1} v = htab_get(lds 1 (ts + 64), k);
  if v.0 == 0 {
    return <0, 0, 0, 0>;
  }
  return lds {1,1,1,1} (v.1);
}
fun 1 account_exists(1 addr) {
  var 1 a = get_account_optional(addr);
  if a == 1 {
    return 0;
  }
  return 1;
}
fun 1 account_has_storage(1 addr) {
  var {1,1} m = htab_get(lds 1 (ts + 32), addr);
  if m.0 != 0 {
    if (lds 1 (m.1 + 24)) >+ 0 {
      return 1;
    }
  }
  m = htab_get(lds 1 (bs + 32), addr);
  if m.0 != 0 {
    if (lds 1 (m.1 + 24)) >+ 0 {
      return 1;
    }
  }
  record_pre_state_read(addr);
  var 1 r = ws_account_has_storage(addr);
  return r;
}
fun 1 account_deployable(1 addr) {
  var 1 a = get_account(addr);
  if (lds 1 (a + 0)) != 0 {
    return 0;
  }
  var 1 eq = memeq(lds 1 (a + 48), empty_code_hash, 32);
  if eq == 0 {
    return 0;
  }
  var 1 hs = account_has_storage(addr);
  if hs != 0 {
    return 0;
  }
  return 1;
}
fun 1 acct_is_empty(1 a) {
  if (lds 1 (a + 0)) != 0 {
    return 0;
  }
  var 1 eq = memeq(lds 1 (a + 48), empty_code_hash, 32);
  if eq == 0 {
    return 0;
  }
  var 1 z = u256_is_zero(lds {1,1,1,1} (a + 8));
  return z;
}
fun 1 account_exists_and_is_empty(1 addr) {
  var 1 a = get_account_optional(addr);
  if a == 1 {
    return 0;
  }
  var 1 e = acct_is_empty(a);
  return e;
}
fun 1 is_account_alive(1 addr) {
  var 1 a = get_account_optional(addr);
  if a == 1 {
    return 0;
  }
  var 1 e = acct_is_empty(a);
  if e != 0 {
    return 0;
  }
  return 1;
}
fun 1 set_account(1 addr, 1 a) {
  jset(lds 1 (ts + 16), addr, a);
  return 0;
}
fun 1 set_storage(1 addr, 1 key, {1,1,1,1} value) {
  var 1 a = get_account_optional(addr);
  if a == 1 {
    throw StateErr 3;
  }
  var outer = lds 1 (ts + 32);
  var {1,1} m = htab_get(outer, addr);
