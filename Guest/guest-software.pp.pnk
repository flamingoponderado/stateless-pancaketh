  skip;
  validate_header(parent, hdr);
  skip;
  be = alloc(120);
  memzero(be, 120);
  st be + 0, lds 1 (si + 88);
  st be + 8, lds 1 (hdr + 104);
  st be + 16, block_hashes;
  st be + 24, block_hashes_n;
  st be + 32, lds 1 (hdr + 24);
  st be + 40, lds 1 (hdr + 96);
  st be + 48, lds {1,1,1,1} (hdr + 160);
  st be + 80, lds 1 (hdr + 120);
  st be + 88, lds 1 (hdr + 144);
  st be + 96, lds 1 (hdr + 208);
  st be + 104, lds 1 (hdr + 216);
  st be + 112, lds 1 (hdr + 240);
  skip;
  execute_block(si, hdr);
  skip;
  return 0;
}
