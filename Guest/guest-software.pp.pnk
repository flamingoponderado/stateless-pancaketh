fun 1 bn254_pairing_check(1 pairs, 1 n_pairs) {
  bn254_init();
  var mark = heap_mark();
  var g1 = alloc(96);
  var g2 = alloc(192);
  var t1 = alloc(96);
  var t2 = alloc(192);
  var Q = alloc(1152);
  var P = alloc(1152);
  var fnum = alloc(384);
  var fden = alloc(384);
  var anum = alloc(384);
  var aden = alloc(384);
  var res = alloc(384);
  fe_set_one(12, anum);
  fe_set_one(12, aden);
  var nontrivial = 0;
  var i = 0;
  while i <+ n_pairs {
    var chunk = pairs + i * 192;
    var 1 e1 = bn254_parse_g1(chunk, g1);
    if e1 != 0 {
      heap_release(mark);
      return 2;
    }
    var 1 e2 = bn254_parse_g2(chunk + 64, g2);
    if e2 != 0 {
      heap_release(mark);
      return 2;
    }
    ecp_mul(1, t1, g1, <4891460686036598785, 2896914383306846353, -5165552122434856867, 3486998266802970665>);
    var 1 i1 = ecp_is_inf(1, t1);
    if i1 == 0 {
      heap_release(mark);
      return 2;
    }
    ecp_mul(2, t2, g2, <4891460686036598785, 2896914383306846353, -5165552122434856867, 3486998266802970665>);
    var 1 i2 = ecp_is_inf(2, t2);
    if i2 == 0 {
      heap_release(mark);
      return 2;
    }
    var 1 pinf = ecp_is_inf(1, g1);
    var 1 qinf = ecp_is_inf(2, g2);
    if (pinf | qinf) == 0 {
      fq12_twist(Q, g2);
      fq12_cast(P, g1);
      bn254_miller_raw(fnum, fden, Q, P);
      fq12_mul(anum, anum, fnum);
      fq12_mul(aden, aden, fden);
