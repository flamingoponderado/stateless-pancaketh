  var 1 rroot = alloc(32);
  build_mpt_indexed(rcs, ntx, rroot);
  var 1 bloom = alloc(256);
  logs_bloom(lds 1 (bo + 40), bloom);
  var 1 wroot = alloc(32);
  build_mpt_indexed(wd_rlp_slices, lds 1 (pl + 56), wroot);
  var 1 rqh = alloc(32);
  compute_requests_hash(lds 1 (bo + 56), lds 1 (bo + 64), rqh);
  var 1 balh = alloc(32);
  keccak256(bal.0, bal.1, balh);
  var 1 bgu = max(lds 1 (bo + 0), lds 1 (bo + 8));
  if bgu != (lds 1 (hdr + 112)) {
    throw BlockErr 110;
  }
  var 1 eq = memeq(txroot, lds 1 (hdr + 40), 32);
  if eq == 0 {
    throw BlockErr 111;
  }
  eq = memeq(root, lds 1 (hdr + 32), 32);
  if eq == 0 {
    throw BlockErr 112;
  }
  eq = memeq(rroot, lds 1 (hdr + 48), 32);
  if eq == 0 {
    throw BlockErr 113;
  }
  eq = memeq(bloom, lds 1 (hdr + 56), 256);
  if eq == 0 {
    throw BlockErr 114;
  }
  eq = memeq(wroot, lds 1 (hdr + 192), 32);
  if eq == 0 {
    throw BlockErr 115;
  }
  if (lds 1 (bo + 48)) != (lds 1 (hdr + 200)) {
    throw BlockErr 116;
  }
  eq = memeq(rqh, lds 1 (hdr + 224), 32);
  if eq == 0 {
    throw BlockErr 117;
  }
  eq = memeq(balh, lds 1 (hdr + 232), 32);
  if eq == 0 {
    throw BlockErr 118;
