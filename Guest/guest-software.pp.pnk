  var 1 r = get_account(recipient);
  r = acct_copy(r);
  nb = u256_add(lds {1,1,1,1} (r + 8), amount);
  st r + 8, nb;
  modify_state_commit(recipient, r);
  return 0;
}
fun 1 create_ether(1 addr, {1,1,1,1} amount) {
  var 1 a = get_account(addr);
  a = acct_copy(a);
  var {1,1,1,1} nb = u256_add(lds {1,1,1,1} (a + 8), amount);
  st a + 8, nb;
