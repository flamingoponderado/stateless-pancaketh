}
fun 1 destroy_storage(1 addr) {
  var outer = lds 1 (ts + 32);
  var {1,1} m = htab_get(outer, addr);
  if m.0 == 0 {
    return 0;
  }
  var inner = m.1;
  var cap = lds 1 (inner + 24);
  var i = 0;
  while i < cap {
    var {1,1,1} s = htab_item(inner, i);
    if s.0 != 0 {
      var 1 k = sk_make(addr, s.1);
      htab_set(lds 1 (ts + 24), k, 1);
    }
