    st bs + 64, offset;
  } else {
    if offset >+ (lds 1 (bs + 64)) {
      st bs + 64, offset;
    }
  }
  return 0;
}
var 1 bal_accounts = 0;
var 1 bal_index = 0;
var 1 bal_idx_accts = 0;
var 1 bal_idx_stor = 0;
var 1 bal_key_buf = 0;
fun 1 lst_new(1 esz, 1 cap) {
  var 1 l = alloc(24);
  var 1 p = alloc(esz * cap);
  st l + 0, p;
  st l + 8, 0;
  st l + 16, cap;
  return l;
}
fun 1 lst_new_scratch(1 esz, 1 cap) {
  var 1 l = scratch_alloc(24);
  var 1 p = scratch_alloc(esz * cap);
  st l + 0, p;
  st l + 8, 0;
  st l + 16, cap;
  return l;
}
fun 1 lst_push(1 l, 1 esz) {
  var n = lds 1 (l + 8);
  var cap = lds 1 (l + 16);
  if n >=+ cap {
    var 1 np = alloc(esz * cap * 2);
    memcpy(np, lds 1 (l + 0), esz * n);
    st l + 0, np;
    st l + 16, cap * 2;
  }
  st l + 8, n + 1;
  return (lds 1 (l + 0)) + n * esz;
}
fun 1 bal_init() {
  bal_accounts = htab_new(20, 64);
  bal_idx_accts = htab_new(28, 64);
  bal_idx_stor = htab_new(60, 64);
  bal_key_buf = alloc(64);
  bal_index = 0;
  return 0;
}
fun 1 bal_ensure_account(1 addr) {
  var {1,1} m = htab_get(bal_accounts, addr);
  if m.0 != 0 {
    return m.1;
  }
  var 1 ad = alloc(40);
  var 1 t = htab_new(32, 8);
  st ad + 0, t;
  t = htab_new(32, 8);
  st ad + 8, t;
  var 1 l = lst_new(40, 4);
  st ad + 16, l;
  l = lst_new(16, 4);
  st ad + 24, l;
  l = lst_new(24, 2);
  st ad + 32, l;
  htab_set(bal_accounts, addr, ad);
  return ad;
}
fun 1 lst_upsert_idx(1 l, 1 esz, 1 idx) {
  var n = lds 1 (l + 8);
  var p = lds 1 (l + 0);
  var i = 0;
  while i < n {
    if (lds 1 (p + i * esz)) == idx {
      return p + i * esz;
    }
    i = i + 1;
  }
  var 1 e = lst_push(l, esz);
  st e, idx;
  return e;
}
fun 1 add_storage_write(1 addr, 1 slot, 1 idx, {1,1,1,1} new_value) {
  var 1 ad = bal_ensure_account(addr);
  var t = lds 1 (ad + 0);
  var {1,1} m = htab_get(t, slot);
  var l = 0;
  if m.0 == 0 {
    l = lst_new(40, 2);
    htab_set(t, slot, l);
  } else {
    l = m.1;
  }
  var 1 e = lst_upsert_idx(l, 40, idx);
  st e + 8, new_value;
  return 0;
}
fun 1 add_storage_read(1 addr, 1 slot) {
  var 1 ad = bal_ensure_account(addr);
  htab_set(lds 1 (ad + 8), slot, 1);
  return 0;
}
fun 1 add_balance_change(1 addr, 1 idx, {1,1,1,1} post_balance) {
  var 1 ad = bal_ensure_account(addr);
  var 1 e = lst_upsert_idx(lds 1 (ad + 16), 40, idx);
  st e + 8, post_balance;
  return 0;
}
fun 1 add_nonce_change(1 addr, 1 idx, 1 new_nonce) {
  var 1 ad = bal_ensure_account(addr);
  var l = lds 1 (ad + 24);
  var n = lds 1 (l + 8);
  var p = lds 1 (l + 0);
  var i = 0;
  while i < n {
    if (lds 1 (p + i * 16)) == idx {
      if new_nonce >+ (lds 1 (p + i * 16 + 8)) {
        st p + i * 16 + 8, new_nonce;
      }
      return 0;
    }
    i = i + 1;
  }
  var 1 e = lst_push(l, 16);
  st e, idx;
  st e + 8, new_nonce;
  return 0;
}
fun 1 add_code_change(1 addr, 1 idx, 1 code, 1 code_len) {
  var 1 ad = bal_ensure_account(addr);
  var 1 e = lst_upsert_idx(lds 1 (ad + 32), 24, idx);
  st e + 8, code;
  st e + 16, code_len;
  return 0;
}
fun 1 add_touched_account(1 addr) {
  bal_ensure_account(addr);
  return 0;
}
fun 1 get_pre_tx_account(1 addr) {
  var {1,1} w = htab_get(lds 1 (bs + 16), addr);
  if w.0 != 0 {
    return w.1;
  }
  record_pre_state_read(addr);
  var 1 a = ws_get_account_optional(addr);
  return a;
}
fun {1,1,1,1} get_pre_tx_storage(1 addr, 1 key) {
  var {1,1} v = stor_lookup(lds 1 (bs + 32), addr, key);
  if v.0 != 0 {
    return lds {1,1,1,1} (v.1);
  }
  record_pre_state_read(addr);
  var {1,1,1,1} r = ws_get_storage(addr, key);
  return r;
}
fun 1 idx_start_account(1 addr) {
  var 1 kb = bal_key_buf;
  st_le64(kb, bal_index);
  memcpy(kb + 8, addr, 20);
  var {1,1} m = htab_get(bal_idx_accts, kb);
  if m.0 != 0 {
    return m.1;
  }
  var 1 pre = get_pre_tx_account(addr);
  var 1 rec = alloc(80);
  memzero(rec, 80);
  memcpy(rec + 48, empty_code_hash, 32);
  if pre != 1 {
    st rec, 1;
    st rec + 8, lds 1 (pre + 0);
    st rec + 16, lds {1,1,1,1} (pre + 8);
    memcpy(rec + 48, lds 1 (pre + 48), 32);
  }
  st_le64(kb, bal_index);
  memcpy(kb + 8, addr, 20);
  htab_set(bal_idx_accts, kb, rec);
  return rec;
}
fun {1,1,1,1} idx_start_storage(1 addr, 1 key) {
  var 1 kb = bal_key_buf;
  st_le64(kb, bal_index);
  memcpy(kb + 8, addr, 20);
  memcpy(kb + 28, key, 32);
  var {1,1} m = htab_get(bal_idx_stor, kb);
  if m.0 != 0 {
    return lds {1,1,1,1} (m.1);
  }
  var {1,1,1,1} v = get_pre_tx_storage(addr, key);
  var 1 rec = alloc(32);
  st rec, v;
  st_le64(kb, bal_index);
  memcpy(kb + 8, addr, 20);
  memcpy(kb + 28, key, 32);
  htab_set(bal_idx_stor, kb, rec);
  return v;
}
fun 1 bal_list_remove_idx(1 l, 1 esz, 1 idx) {
  var n = lds 1 (l + 8);
  var p = lds 1 (l + 0);
  var i = 0;
  while i < n {
    if (lds 1 (p + i * esz)) == idx {
      if i != (n - 1) {
        memcpy(p + i * esz, p + (n - 1) * esz, esz);
      }
      st l + 8, n - 1;
      return 0;
    }
    i = i + 1;
  }
  return 0;
}
fun 1 bal_remove_change(1 addr, 1 which, 1 esz, 1 idx) {
  var {1,1} m = htab_get(bal_accounts, addr);
  if m.0 == 0 {
    return 0;
  }
  bal_list_remove_idx(lds 1 (m.1 + which), esz, idx);
  return 0;
}
fun 1 remove_storage_write(1 addr, 1 slot, 1 idx) {
  var {1,1} m = htab_get(bal_accounts, addr);
  if m.0 == 0 {
    return 0;
  }
  var t = lds 1 (m.1 + 0);
  var {1,1} sl = htab_get(t, slot);
  if sl.0 == 0 {
    return 0;
  }
  bal_list_remove_idx(sl.1, 40, idx);
  if (lds 1 (sl.1 + 8)) == 0 {
    htab_del(t, slot);
  }
  return 0;
}
fun 1 update_builder_from_tx() {
  var idx = bal_index;
  var aw = lds 1 (ts + 16);
  var cap = lds 1 (aw + 24);
  var i = 0;
  while i < cap {
    var {1,1,1} s = htab_item(aw, i);
    if s.0 != 0 {
      var addr = s.1;
      var post = s.2;
      var 1 pre = idx_start_account(addr);
      var {1,1,1,1} pre_bal = lds {1,1,1,1} (pre + 16);
      var pre_nonce = lds 1 (pre + 8);
      var pre_ch = pre + 48;
      var {1,1,1,1} post_bal = <0, 0, 0, 0>;
      var post_nonce = 0;
      var post_ch = empty_code_hash;
      if post != 1 {
        post_bal = lds {1,1,1,1} (post + 8);
        post_nonce = lds 1 (post + 0);
        post_ch = lds 1 (post + 48);
      }
      var 1 eq = u256_eq(pre_bal, post_bal);
      if eq == 0 {
        add_balance_change(addr, idx, post_bal);
      } else {
        bal_remove_change(addr, 16, 40, idx);
      }
      if pre_nonce != post_nonce {
        add_nonce_change(addr, idx, post_nonce);
      } else {
        bal_remove_change(addr, 24, 16, idx);
      }
      eq = memeq(pre_ch, post_ch, 32);
      if eq == 0 {
        var {1,1} code = get_code(post_ch, addr);
        add_code_change(addr, idx, code.0, code.1);
      } else {
        bal_remove_change(addr, 32, 24, idx);
      }
    }
    i = i + 1;
  }
  var outer = lds 1 (ts + 32);
  cap = lds 1 (outer + 24);
  i = 0;
  while i < cap {
    var {1,1,1} s2 = htab_item(outer, i);
    if s2.0 != 0 {
      var inner = s2.2;
      var icap = lds 1 (inner + 24);
      var j = 0;
      while j < icap {
        var {1,1,1} e = htab_item(inner, j);
        if e.0 != 0 {
          var {1,1,1,1} pre_v = idx_start_storage(s2.1, e.1);
          var {1,1,1,1} post_v = lds {1,1,1,1} (e.2);
          var 1 eq2 = u256_eq(pre_v, post_v);
          if eq2 == 0 {
            add_storage_write(s2.1, e.1, idx, post_v);
          } else {
            remove_storage_write(s2.1, e.1, idx);
          }
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return 0;
}
fun 1 incorporate_tx_into_block() {
  update_builder_from_tx();
  merge_tx_into_block();
  return 0;
}
fun 1 bal_sort_gt(1 a, 1 b, 1 kind) {
  if kind == 0 {
    if (lds 1 a) >+ (lds 1 b) {
      return 1;
    }
    return 0;
  }
  var len = 20;
  if kind == 2 {
    len = 32;
  }
  var k = 0;
  while k < len {
    var ca = ld8 (a + k);
    var cb = ld8 (b + k);
    if ca != cb {
      if ca >+ cb {
        return 1;
      }
      return 0;
    }
    k = k + 1;
  }
  return 0;
}
fun 1 sort_elems(1 p, 1 n, 1 esz, 1 kind, 1 tmp) {
  if n <+ 2 {
    return 0;
  }
  var 1 mark = heap_mark();
  var 1 aux = alloc(n * esz);
  var 1 src = p;
  var 1 dst = aux;
  var width = 1;
  while width < n {
    var left = 0;
    while left < n {
      var mid = left + width;
      if mid >+ n {
        mid = n;
      }
      var right = mid + width;
      if right >+ n {
        right = n;
      }
      var i = left;
      var j = mid;
      var k = left;
      while (i < mid) && (j < right) {
        var a = src + i * esz;
        var b = src + j * esz;
        var 1 gt = bal_sort_gt(a, b, kind);
        if gt == 0 {
          memcpy(dst + k * esz, a, esz);
          i = i + 1;
        } else {
          memcpy(dst + k * esz, b, esz);
          j = j + 1;
        }
        k = k + 1;
      }
      while i < mid {
        memcpy(dst + k * esz, src + i * esz, esz);
        i = i + 1;
        k = k + 1;
      }
      while j < right {
        memcpy(dst + k * esz, src + j * esz, esz);
        j = j + 1;
        k = k + 1;
      }
      left = right;
    }
    var 1 swap = src;
    src = dst;
    dst = swap;
    width = width * 2;
  }
  if src != p {
    memcpy(p, src, n * esz);
  }
  heap_release(mark);
  return 0;
}
fun {1,1} sorted_keys32(1 t, 1 tmp) {
  var {1,1} k = htab_keys(t);
  sort_elems(k.0, k.1, 32, 2, tmp);
  return k;
}
fun 1 bal_encode_account(1 dst, 1 addr, 1 ad, 1 tmp) {
  var p = dst + 9;
  var 1 w = rlp_encode_bytes(p, addr, 20);
  p = p + w;
  var 1 mark = heap_mark();
  var sc = lds 1 (ad + 0);
  var {1,1} slots = sorted_keys32(sc, tmp);
  var q = p + 9;
  var i = 0;
  while i < slots.1 {
    var slot = slots.0 + i * 32;
    var {1,1} m = htab_get(sc, slot);
    var l = m.1;
    var n = lds 1 (l + 8);
    var lp = lds 1 (l + 0);
    sort_elems(lp, n, 40, 0, tmp);
    var r = q + 9;
    var {1,1,1,1} sv = u256_from_be(slot, 32);
    w = rlp_put_u256(r, sv);
    r = r + w;
    var cs = r + 9;
    var j = 0;
    while j < n {
      var e = lp + j * 40;
      var c = cs + 9;
      w = rlp_encode_word(c, lds 1 e);
      c = c + w;
      w = rlp_put_u256(c, lds {1,1,1,1} (e + 8));
      c = c + w;
      var 1 hl = rlp_list_header_len(c - (cs + 9));
      memcpy(cs + hl, cs + 9, c - (cs + 9));
      rlp_encode_list_header(cs, c - (cs + 9));
      cs = cs + hl + (c - (cs + 9));
      j = j + 1;
    }
    var 1 hl2 = rlp_list_header_len(cs - (r + 9));
    memcpy(r + hl2, r + 9, cs - (r + 9));
    rlp_encode_list_header(r, cs - (r + 9));
    r = r + hl2 + (cs - (r + 9));
    var 1 hl3 = rlp_list_header_len(r - (q + 9));
    memcpy(q + hl3, q + 9, r - (q + 9));
    rlp_encode_list_header(q, r - (q + 9));
    q = q + hl3 + (r - (q + 9));
    i = i + 1;
  }
  var 1 hl4 = rlp_list_header_len(q - (p + 9));
  memcpy(p + hl4, p + 9, q - (p + 9));
  rlp_encode_list_header(p, q - (p + 9));
  p = p + hl4 + (q - (p + 9));
  var sr = lds 1 (ad + 8);
  var {1,1} rk = htab_keys(sr);
  var kept = 0;
  i = 0;
  while i < rk.1 {
    var 1 hasw = htab_has(sc, rk.0 + i * 32);
    if hasw == 0 {
      st rk.0 + kept * 32, lds {1,1,1,1} (rk.0 + i * 32);
      kept = kept + 1;
    }
    i = i + 1;
  }
  sort_elems(rk.0, kept, 32, 2, tmp);
  q = p + 9;
  i = 0;
  while i < kept {
    var {1,1,1,1} sv2 = u256_from_be(rk.0 + i * 32, 32);
    w = rlp_put_u256(q, sv2);
    q = q + w;
    i = i + 1;
  }
  var 1 hl5 = rlp_list_header_len(q - (p + 9));
  memcpy(p + hl5, p + 9, q - (p + 9));
  rlp_encode_list_header(p, q - (p + 9));
  p = p + hl5 + (q - (p + 9));
  var l2 = lds 1 (ad + 16);
  var n2 = lds 1 (l2 + 8);
  var lp2 = lds 1 (l2 + 0);
  sort_elems(lp2, n2, 40, 0, tmp);
  q = p + 9;
  i = 0;
  while i < n2 {
    var e2 = lp2 + i * 40;
    var c2 = q + 9;
    w = rlp_encode_word(c2, lds 1 e2);
    c2 = c2 + w;
    w = rlp_put_u256(c2, lds {1,1,1,1} (e2 + 8));
    c2 = c2 + w;
    var 1 hl6 = rlp_list_header_len(c2 - (q + 9));
    memcpy(q + hl6, q + 9, c2 - (q + 9));
    rlp_encode_list_header(q, c2 - (q + 9));
    q = q + hl6 + (c2 - (q + 9));
    i = i + 1;
  }
  var 1 hl7 = rlp_list_header_len(q - (p + 9));
  memcpy(p + hl7, p + 9, q - (p + 9));
  rlp_encode_list_header(p, q - (p + 9));
  p = p + hl7 + (q - (p + 9));
  var l3 = lds 1 (ad + 24);
  var n3 = lds 1 (l3 + 8);
  var lp3 = lds 1 (l3 + 0);
  sort_elems(lp3, n3, 16, 0, tmp);
  q = p + 9;
  i = 0;
  while i < n3 {
    var e3 = lp3 + i * 16;
    var c3 = q + 9;
    w = rlp_encode_word(c3, lds 1 e3);
    c3 = c3 + w;
    w = rlp_encode_word(c3, lds 1 (e3 + 8));
    c3 = c3 + w;
    var 1 hl8 = rlp_list_header_len(c3 - (q + 9));
    memcpy(q + hl8, q + 9, c3 - (q + 9));
    rlp_encode_list_header(q, c3 - (q + 9));
    q = q + hl8 + (c3 - (q + 9));
    i = i + 1;
  }
  var 1 hl9 = rlp_list_header_len(q - (p + 9));
  memcpy(p + hl9, p + 9, q - (p + 9));
  rlp_encode_list_header(p, q - (p + 9));
  p = p + hl9 + (q - (p + 9));
  var l4 = lds 1 (ad + 32);
  var n4 = lds 1 (l4 + 8);
  var lp4 = lds 1 (l4 + 0);
  sort_elems(lp4, n4, 24, 0, tmp);
  q = p + 9;
  i = 0;
  while i < n4 {
    var e4 = lp4 + i * 24;
    var c4 = q + 9;
    w = rlp_encode_word(c4, lds 1 e4);
    c4 = c4 + w;
    w = rlp_encode_bytes(c4, lds 1 (e4 + 8), lds 1 (e4 + 16));
    c4 = c4 + w;
    var 1 hl10 = rlp_list_header_len(c4 - (q + 9));
    memcpy(q + hl10, q + 9, c4 - (q + 9));
    rlp_encode_list_header(q, c4 - (q + 9));
    q = q + hl10 + (c4 - (q + 9));
    i = i + 1;
  }
  var 1 hl11 = rlp_list_header_len(q - (p + 9));
  memcpy(p + hl11, p + 9, q - (p + 9));
  rlp_encode_list_header(p, q - (p + 9));
  p = p + hl11 + (q - (p + 9));
  heap_release(mark);
  var payload = p - (dst + 9);
  var 1 hl12 = rlp_list_header_len(payload);
  memcpy(dst + hl12, dst + 9, payload);
  rlp_encode_list_header(dst, payload);
  return hl12 + payload;
}
fun {1,1} build_block_access_list_rlp() {
  var sr = lds 1 (bs + 24);
  var cap = lds 1 (sr + 24);
  var i = 0;
  while i < cap {
    var {1,1,1} s = htab_item(sr, i);
    if s.0 != 0 {
      add_storage_read(s.1, s.1 + 20);
    }
    i = i + 1;
  }
  var ar = lds 1 (bs + 8);
  cap = lds 1 (ar + 24);
  i = 0;
  while i < cap {
    var {1,1,1} s2 = htab_item(ar, i);
    if s2.0 != 0 {
      add_touched_account(s2.1);
    }
    i = i + 1;
  }
  var 1 tmp = alloc(64);
  var {1,1} addrs = htab_keys(bal_accounts);
  sort_elems(addrs.0, addrs.1, 24, 1, tmp);
  var total = 1024;
  i = 0;
  while i < addrs.1 {
    var {1,1} m = htab_get(bal_accounts, addrs.0 + i * 24);
    var ad = m.1;
    total = total + 128 + (lds 1 ((lds 1 (ad + 8)) + 24)) * 40;
    total = total + (lds 1 ((lds 1 (ad + 0)) + 24)) * 96;
    var sc = lds 1 (ad + 0);
    var scap = lds 1 (sc + 24);
    var j = 0;
    while j < scap {
      var {1,1,1} e = htab_item(sc, j);
      if e.0 != 0 {
        total = total + (lds 1 (e.2 + 8)) * 48;
      }
      j = j + 1;
    }
    total = total + (lds 1 ((lds 1 (ad + 16)) + 8)) * 48;
    total = total + (lds 1 ((lds 1 (ad + 24)) + 8)) * 24;
    var cl = lds 1 (ad + 32);
    var cn = lds 1 (cl + 8);
    var cp = lds 1 (cl + 0);
    j = 0;
    while j < cn {
      total = total + 32 + (lds 1 (cp + j * 24 + 16));
      j = j + 1;
    }
    i = i + 1;
  }
  var 1 buf = alloc(total + 64);
  var p = buf + 9;
  i = 0;
  while i < addrs.1 {
    var {1,1} m2 = htab_get(bal_accounts, addrs.0 + i * 24);
    var 1 w = bal_encode_account(p, addrs.0 + i * 24, m2.1, tmp);
    p = p + w;
    i = i + 1;
  }
  var payload = p - (buf + 9);
  var 1 hl = rlp_list_header_len(payload);
  var start = buf + 9 - hl;
  rlp_encode_list_header(start, payload);
  return <start, hl + payload>;
}
fun 1 validate_block_access_list_gas_limit(1 block_gas_limit) {
  var items = 0;
  var cap = lds 1 (bal_accounts + 24);
  var i = 0;
  while i < cap {
    var {1,1,1} s = htab_item(bal_accounts, i);
    if s.0 != 0 {
      var ad = s.2;
      var sc = lds 1 (ad + 0);
      var sr = lds 1 (ad + 8);
      items = items + 1 + (lds 1 (sc + 24));
      var rcap = lds 1 (sr + 24);
      var j = 0;
      while j < rcap {
        var {1,1,1} e = htab_item(sr, j);
        if e.0 != 0 {
          var 1 hasw = htab_has(sc, e.1);
          if hasw == 0 {
            items = items + 1;
          }
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  var 1 lim = udiv(block_gas_limit, 2000);
  if items >+ lim {
    throw BlockErr 40;
