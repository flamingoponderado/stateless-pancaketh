/* lib/blake2.pnk -- BLAKE2b compression function F (RFC 7693 section 3.2).
   Port of SpecRef PrecompilesHash.lean namespace Blake2b (G / compress), i.e.
   ethereum/crypto/blake2.py class Blake2b.  Lanes are native 64-bit words
   (Pancake arithmetic wraps mod 2^64; #>> is rotate right).  Needs lib/mem.pnk.
   Call blake2_init before compression. */

var 1 b2_sigma = 0;  /* 10 schedule rows, 16 nibbles per word */
var 1 b2_iv = 0;     /* 8 IV words */
var 1 b2_v = 0;      /* 16-word working vector */
#ifdef ZISK_ACCEL
var 1 b2_m = 0;      /* aligned message block for the round CSR */
var 1 b2_round = 0;  /* {round index, v pointer, m pointer} */
#endif

#define B2_SIG(row, i) (((lds 1 (b2_sigma + (row) * 8)) >>> ((i) * 4)) & 15)
#define V(i) (lds 1 (b2_v + (i) * 8))

fun 1 blake2_init() {
  if b2_sigma != 0 {
    return 0;
  }
  b2_sigma = alloc(80);
  b2_iv = alloc(64);
#ifdef ZISK_ACCEL
  /* One 264-byte block, the array of the foreign call (docs/ACCEL-FFI.md): the
     SIGMA row (a value), the 128-byte working vector and the 128-byte message; the
     stub builds the CSR's {row, v pointer, m pointer} from the array pointer. */
  b2_round = alloc(264);
  b2_v = b2_round + 8;
  b2_m = b2_round + 136;
#else
  b2_v = alloc(128);
#endif
  st b2_sigma + 0, -81985529216486896;
  st b2_sigma + 8, 3853709921291437230;
  st b2_sigma + 16, 5266788149650328715;
  st b2_sigma + 24, -8141200382097550441;
  st b2_sigma + 32, -3204650750919412471;
  st b2_sigma + 40, -7931023849780369726;
  st b2_sigma + 48, -5176546439255363236;
  st b2_sigma + 56, -6744053556625741891;
  st b2_sigma + 64, 6503616966983130870;
  st b2_sigma + 72, 991893350865389610;
  st b2_iv + 0, 7640891576956012808;
  st b2_iv + 8, -4942790177534073029;
  st b2_iv + 16, 4354685564936845355;
  st b2_iv + 24, -6534734903238641935;
  st b2_iv + 32, 5840696475078001361;
  st b2_iv + 40, -7276294671716946913;
  st b2_iv + 48, 2270897969802886507;
  st b2_iv + 56, 6620516959819538809;
  return 0;
}

#ifndef ZISK_ACCEL
/* G(v, a, b, c, d, x, y) on the working vector b2_v (indices in words). */
fun 1 blake2_g(1 a, 1 b, 1 c, 1 d, 1 x, 1 y) {
  var pa = b2_v + a * 8;
  var pb = b2_v + b * 8;
  var pc = b2_v + c * 8;
  var pd = b2_v + d * 8;
  var va = lds 1 pa;
  var vb = lds 1 pb;
  var vc = lds 1 pc;
  var vd = lds 1 pd;
  va = va + vb + x;
  vd = (vd ^ va) #>> 32;
  vc = vc + vd;
  vb = (vb ^ vc) #>> 24;
  va = va + vb + y;
  vd = (vd ^ va) #>> 16;
  vc = vc + vd;
  vb = (vb ^ vc) #>> 63;
  st pa, va;
  st pb, vb;
  st pc, vc;
  st pd, vd;
  return 0;
}
#endif

/* compress(rounds, h, m, t0, t1, f): h = 8 lanes (updated in place to the
   output state h[i] ^ v[i] ^ v[i+8]), m = 16 message lanes, f = 0 or 1. */
fun 1 blake2b_f(1 rounds, 1 h, 1 m, 1 t0, 1 t1, 1 f) {
  memcpy(b2_v, h, 64);
  memcpy(b2_v + 64, b2_iv, 64);
  st b2_v + 96, V(12) ^ t0;
  st b2_v + 104, V(13) ^ t1;
  if f != 0 {
    st b2_v + 112, V(14) ^ (0 - 1);
  }
#ifdef ZISK_ACCEL
  /* The CSR reads sixteen aligned little-endian u64s.  Copying also makes
     precompile input safe when the caller's data pointer is unaligned. */
  memcpy(b2_m, m, 128);
  var r = 0;
  var row = 0;
  while r <+ rounds {
    /* The CSR takes a SIGMA row, not a round number: ZisK's csrsValid rejects
       an index >= 10 and the machine then traps.  Wrap the row
       index at 10; BLAKE2b's standard 12 rounds reach row 10 twice. */
    st b2_round, row;
    @blake2bround(b2_round, 0, b2_round, 264);
    r = r + 1;
    row = row + 1;
    if row == 10 {
      row = 0;
    }
  }
#else
  var r = 0;
  var row = 0;
  while r <+ rounds {
    blake2_g(0, 4, 8, 12, lds 1 (m + B2_SIG(row, 0) * 8), lds 1 (m + B2_SIG(row, 1) * 8));
    blake2_g(1, 5, 9, 13, lds 1 (m + B2_SIG(row, 2) * 8), lds 1 (m + B2_SIG(row, 3) * 8));
    blake2_g(2, 6, 10, 14, lds 1 (m + B2_SIG(row, 4) * 8), lds 1 (m + B2_SIG(row, 5) * 8));
    blake2_g(3, 7, 11, 15, lds 1 (m + B2_SIG(row, 6) * 8), lds 1 (m + B2_SIG(row, 7) * 8));
    blake2_g(0, 5, 10, 15, lds 1 (m + B2_SIG(row, 8) * 8), lds 1 (m + B2_SIG(row, 9) * 8));
    blake2_g(1, 6, 11, 12, lds 1 (m + B2_SIG(row, 10) * 8), lds 1 (m + B2_SIG(row, 11) * 8));
    blake2_g(2, 7, 8, 13, lds 1 (m + B2_SIG(row, 12) * 8), lds 1 (m + B2_SIG(row, 13) * 8));
    blake2_g(3, 4, 9, 14, lds 1 (m + B2_SIG(row, 14) * 8), lds 1 (m + B2_SIG(row, 15) * 8));
    r = r + 1;
    row = row + 1;
    if row == 10 {
      row = 0;
    }
  }
#endif
  var i = 0;
  while i < 8 {
    st h + i * 8, (lds 1 (h + i * 8)) ^ V(i) ^ V(i + 8);
    i = i + 1;
  }
  return 0;
}
