/* lib/fp384.pnk -- arithmetic in Fp for the BLS12-381 base field
   p = 0x1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaab
   (PrecompilesBls.lean blsP; 381 bits).

   An element is the struct FP = {1,1,1,1,1,1}: six little-endian 64-bit limbs,
   .0 least significant; in memory 6 words (48 bytes), limb 0 lowest.  Elements
   are canonical residues, fully reduced (< p), and multiplication is delegated
   to arith384_mod.  fp_to_mont and fp_from_mont are identity functions (the
   names are historical).  Canonical values also appear at the byte boundary
   (fp_decode64 / fp_encode64, parity and half-field comparisons), flagged _can
   in the names.  Constants (p, ...) come from lib/bls12381_consts.pnk,
   generated by tools/blsref.py.

   Inversion: binary extended Euclid on the raw representative, returning the
   canonical inverse directly.  Zero maps to
   zero like py_ecc prime_field_inv.  Exponentiation reads a little-endian
   limb array.
   Needs lib/mem.pnk, lib/arith.pnk, lib/u256.pnk (mul64x64, ALLONES, M32) and
   lib/bls12381_consts.pnk. */

#define FP {1,1,1,1,1,1}
#define FP_BYTES 48
#define FP_ZERO <0, 0, 0, 0, 0, 0>
#define FP_ONE_CAN <1, 0, 0, 0, 0, 0>

/* ---------- inspection ---------- */

fun 1 fp_is_zero(FP a) {
  if (a.0 | a.1 | a.2 | a.3 | a.4 | a.5) == 0 { return 1; }
  return 0;
}

fun 1 fp_eq(FP a, FP b) {
  if ((a.0 ^ b.0) | (a.1 ^ b.1) | (a.2 ^ b.2) | (a.3 ^ b.3) | (a.4 ^ b.4) | (a.5 ^ b.5)) == 0 { return 1; }
  return 0;
}

/* Unsigned 384-bit a < b (on the raw limbs). */
fun 1 fp_lt_raw(FP a, FP b) {
  if a.5 != b.5 { if a.5 <+ b.5 { return 1; } return 0; }
  if a.4 != b.4 { if a.4 <+ b.4 { return 1; } return 0; }
  if a.3 != b.3 { if a.3 <+ b.3 { return 1; } return 0; }
  if a.2 != b.2 { if a.2 <+ b.2 { return 1; } return 0; }
  if a.1 != b.1 { if a.1 <+ b.1 { return 1; } return 0; }
  if a.0 <+ b.0 { return 1; }
  return 0;
}

/* ---------- raw 384-bit add / sub (no reduction) ---------- */

/* <limbs, carry> of a + b. */
fun {1,1,1,1,1,1,1} fp_add_raw(FP a, FP b) {
  var {1,1} r0 = __add_with_carry__(a.0, b.0, 0);
  var {1,1} r1 = __add_with_carry__(a.1, b.1, r0.1);
  var {1,1} r2 = __add_with_carry__(a.2, b.2, r1.1);
  var {1,1} r3 = __add_with_carry__(a.3, b.3, r2.1);
  var {1,1} r4 = __add_with_carry__(a.4, b.4, r3.1);
  var {1,1} r5 = __add_with_carry__(a.5, b.5, r4.1);
  return <r0.0, r1.0, r2.0, r3.0, r4.0, r5.0, r5.1>;
}

/* <limbs, no_borrow> of a - b (no_borrow == 1 iff a >= b). */
fun {1,1,1,1,1,1,1} fp_sub_raw(FP a, FP b) {
  var {1,1} r0 = __add_with_carry__(a.0, b.0 ^ ALLONES, 1);
  var {1,1} r1 = __add_with_carry__(a.1, b.1 ^ ALLONES, r0.1);
  var {1,1} r2 = __add_with_carry__(a.2, b.2 ^ ALLONES, r1.1);
  var {1,1} r3 = __add_with_carry__(a.3, b.3 ^ ALLONES, r2.1);
  var {1,1} r4 = __add_with_carry__(a.4, b.4 ^ ALLONES, r3.1);
  var {1,1} r5 = __add_with_carry__(a.5, b.5 ^ ALLONES, r4.1);
  return <r0.0, r1.0, r2.0, r3.0, r4.0, r5.0, r5.1>;
}

/* ---------- modular add / sub / neg (inputs < p) ---------- */

fun FP fp_add(FP a, FP b) {
  var {1,1,1,1,1,1,1} s = fp_add_raw(a, b);        /* < 2p < 2^382: no carry */
  var FP t = <s.0, s.1, s.2, s.3, s.4, s.5>;
  var {1,1,1,1,1,1,1} d = fp_sub_raw(t, FP_P_LIT);
  if d.6 == 1 {
    return <d.0, d.1, d.2, d.3, d.4, d.5>;
  }
  return t;
}

fun FP fp_sub(FP a, FP b) {
  var {1,1,1,1,1,1,1} d = fp_sub_raw(a, b);
  var FP t = <d.0, d.1, d.2, d.3, d.4, d.5>;
  if d.6 == 1 {
    return t;
  }
  var {1,1,1,1,1,1,1} s = fp_add_raw(t, FP_P_LIT);   /* wraps back into [0, p) */
  return <s.0, s.1, s.2, s.3, s.4, s.5>;
}

fun FP fp_neg(FP a) {
  var 1 z = fp_is_zero(a);
  if z == 1 {
    return FP_ZERO;
  }
  var {1,1,1,1,1,1,1} d = fp_sub_raw(FP_P_LIT, a);
  return <d.0, d.1, d.2, d.3, d.4, d.5>;
}

fun FP fp_dbl(FP a) {
  return fp_add(a, a);
}

/* ---------- Fp multiplication ---------- */

#ifndef ZISK_ACCEL

/* Montgomery multiplication (CIOS). */

/* One CIOS round for the multiplier word bi: t += a * bi (t is t0..t6),
   m = t0 * (-p^-1) mod 2^64, t = (t + m p) / 2^64.  Every carry word c is
   the exact high half of a 128-bit sum t_j + x_j * y + c_in <= 2^128 - 1,
   so pr.1 + s.1 + s2.1 never overflows; with a, b < p the value t stays
   below 2p < 2^382, hence limb 6 (t6) is < 2^62 and there is no limb 7. */
#define MONT_MAC0(aj, bi, tj) \
  pr = mul64x64(aj, bi); s = __add_with_carry__(tj, pr.0, 0); tj = s.0; c = pr.1 + s.1;
#define MONT_MAC(aj, bi, tj) \
  pr = mul64x64(aj, bi); s = __add_with_carry__(tj, pr.0, 0); \
  s2 = __add_with_carry__(s.0, c, 0); tj = s2.0; c = pr.1 + s.1 + s2.1;
/* the m*p pass shifts by one word: the sum limb j lands in t_(j-1) */
#define MONT_RED(pj, tj, tdst) \
  pr = mul64x64(m, pj); s = __add_with_carry__(tj, pr.0, 0); \
  s2 = __add_with_carry__(s.0, c, 0); tdst = s2.0; c = pr.1 + s.1 + s2.1;
#define MONT_ROUND(bi) \
  MONT_MAC0(a.0, bi, t0) \
  MONT_MAC(a.1, bi, t1) \
  MONT_MAC(a.2, bi, t2) \
  MONT_MAC(a.3, bi, t3) \
  MONT_MAC(a.4, bi, t4) \
  MONT_MAC(a.5, bi, t5) \
  t6 = t6 + c; \
  m = t0 * FP_INV; \
  pr = mul64x64(m, FP_P0); s = __add_with_carry__(t0, pr.0, 0); c = pr.1 + s.1; \
  MONT_RED(FP_P1, t1, t0) \
  MONT_RED(FP_P2, t2, t1) \
  MONT_RED(FP_P3, t3, t2) \
  MONT_RED(FP_P4, t4, t3) \
  MONT_RED(FP_P5, t5, t4) \
  t5 = t6 + c; \
  t6 = 0;

/* a * b / 2^384 mod p for a, b < p. */
fun FP fp_mul(FP a, FP b) {
  var t0 = 0; var t1 = 0; var t2 = 0; var t3 = 0; var t4 = 0; var t5 = 0; var t6 = 0;
  var c = 0;
  var m = 0;
  var {1,1} pr = <0, 0>;
  var {1,1} s = <0, 0>;
  var {1,1} s2 = <0, 0>;
  MONT_ROUND(b.0)
  MONT_ROUND(b.1)
  MONT_ROUND(b.2)
  MONT_ROUND(b.3)
  MONT_ROUND(b.4)
  MONT_ROUND(b.5)
  /* t < 2p: one conditional subtraction */
  var {1,1,1,1,1,1,1} d = fp_sub_raw(<t0, t1, t2, t3, t4, t5>, FP_P_LIT);
  if d.6 == 1 {
    return <d.0, d.1, d.2, d.3, d.4, d.5>;
  }
  return <t0, t1, t2, t3, t4, t5>;
}

#else

/* The accelerator consumes canonical little-endian residues and returns
   (a * b) mod p.  Keep one private, single-threaded parameter arena so the
   hot field leaf does not allocate on every call. */
var 1 fp_accel_a = 0;
var 1 fp_accel_b = 0;
var 1 fp_accel_d = 0;
var 1 fp_accel_zero = 0;
var 1 fp_accel_params = 0;

fun 1 fp_accel_init() {
  if fp_accel_params != 0 {
    return 0;
  }
  bls_consts_init();
  /* One 240-byte block, the array of the foreign call (docs/ACCEL-FFI.md): a, b, zero,
     m, d of FP_BYTES each at fixed offsets. The modulus is copied in because the
     accelerator may only touch the array. */
  fp_accel_params = alloc(240);
  fp_accel_a = fp_accel_params;
  fp_accel_b = fp_accel_params + 48;
  fp_accel_zero = fp_accel_params + 96;
  fp_accel_d = fp_accel_params + 192;
  memzero(fp_accel_zero, FP_BYTES);
  memcpy(fp_accel_params + 144, C_P, FP_BYTES);
  return 0;
}

fun FP fp_mul(FP a, FP b) {
  fp_accel_init();
  st fp_accel_a, a;
  st fp_accel_b, b;
  @bls_arith384(fp_accel_params, 0, fp_accel_params, 240);
  return lds FP fp_accel_d;
}

#endif

fun FP fp_sqr(FP a) {
  return fp_mul(a, a);
}

/* canonical x -> internal representation: canonical residues are stored
   directly, so this is the identity. */
fun FP fp_to_mont(FP a) {
#ifdef ZISK_ACCEL
  return a;
#else
  return fp_mul(a, FP_R2_LIT);
#endif
}

/* internal representation -> canonical x. */
fun FP fp_from_mont(FP a) {
#ifdef ZISK_ACCEL
  return a;
#else
  return fp_mul(a, FP_ONE_CAN);
#endif
}

/* ---------- inversion (binary extended Euclid, HAC 14.61) ---------- */

fun FP fp_shr1(FP x) {
  return <(x.0 >>> 1) | (x.1 << 63), (x.1 >>> 1) | (x.2 << 63), (x.2 >>> 1) | (x.3 << 63),
          (x.3 >>> 1) | (x.4 << 63), (x.4 >>> 1) | (x.5 << 63), x.5 >>> 1>;
}

/* x / 2 mod p for x < p: x >> 1 if even, else (x + p) >> 1 (385-bit sum). */
fun FP fp_half_can(FP x) {
  if (x.0 & 1) == 0 {
    return fp_shr1(x);
  }
  var {1,1,1,1,1,1,1} s = fp_add_raw(x, FP_P_LIT);
  return <(s.0 >>> 1) | (s.1 << 63), (s.1 >>> 1) | (s.2 << 63), (s.2 >>> 1) | (s.3 << 63),
          (s.3 >>> 1) | (s.4 << 63), (s.4 >>> 1) | (s.5 << 63), (s.5 >>> 1) | (s.6 << 63)>;
}

/* a^-1 mod p on the raw representative (0 for 0). */
fun FP fp_inv_raw(FP a) {
  var 1 az = fp_is_zero(a);
  if az == 1 {
    return FP_ZERO;
  }
  var FP u = a;
  var FP v = FP_P_LIT;
  var FP x1 = FP_ONE_CAN;
  var FP x2 = FP_ZERO;
  while true {
    if (u.1 | u.2 | u.3 | u.4 | u.5) == 0 {
      if u.0 == 1 { return x1; }
    }
    if (v.1 | v.2 | v.3 | v.4 | v.5) == 0 {
      if v.0 == 1 { return x2; }
    }
    while (u.0 & 1) == 0 {
      u = fp_shr1(u);
      x1 = fp_half_can(x1);
    }
    while (v.0 & 1) == 0 {
      v = fp_shr1(v);
      x2 = fp_half_can(x2);
    }
    var 1 ult = fp_lt_raw(u, v);
    if ult == 0 {
      var {1,1,1,1,1,1,1} d = fp_sub_raw(u, v);
      u = <d.0, d.1, d.2, d.3, d.4, d.5>;
      x1 = fp_sub(x1, x2);
    } else {
      var {1,1,1,1,1,1,1} e = fp_sub_raw(v, u);
      v = <e.0, e.1, e.2, e.3, e.4, e.5>;
      x2 = fp_sub(x2, x1);
    }
  }
  return FP_ZERO;
}

/* Inverse, 0 -> 0 (py_ecc). */
fun FP fp_inv(FP a) {
  var FP r = fp_inv_raw(a);
#ifdef ZISK_ACCEL
  return r;
#else
  return fp_mul(r, FP_R3_LIT);
#endif
}

/* ---------- exponentiation ---------- */

/* a^e; e = n little-endian words at eptr.  MSB-first
   square-and-multiply; e == 0 gives one. */
fun FP fp_pow(FP a, 1 eptr, 1 n) {
  var FP r = FP_ONE_MONT;
  var started = 0;
  var i = n * 64;
  while i >+ 0 {
    i = i - 1;
    if started == 1 {
      r = fp_mul(r, r);
    }
    var bit = ((lds 1 (eptr + (i >>> 6) * 8)) >>> (i & 63)) & 1;
    if bit == 1 {
      r = fp_mul(r, a);
      started = 1;
    }
  }
  return r;
}

/* ---------- canonical-value helpers ---------- */

/* Parity of the canonical value (hash-to-curve sgn0 for m = 1). */
fun 1 fp_sgn0(FP a) {
  var FP c = fp_from_mont(a);
  return c.0 & 1;
}

/* (2 y) / p for y < p, i.e. 1 iff y > (p - 1) / 2 (point_compression a_flag). */
fun 1 fp_is_high(FP a) {
  var FP c = fp_from_mont(a);
  var 1 lt = fp_lt_raw(FP_P_HALF_LIT, c);
  return lt;
}

/* ---------- byte conversion ---------- */

/* Big-endian 48 bytes at p -> canonical limbs (no range check). */
fun FP fp_from_be48(1 p) {
  return <LD_BE64(p + 40), LD_BE64(p + 32), LD_BE64(p + 24), LD_BE64(p + 16), LD_BE64(p + 8), LD_BE64(p)>;
}

fun 1 fp_to_be48(FP a, 1 out) {
  st_be64(out, a.5);
  st_be64(out + 8, a.4);
  st_be64(out + 16, a.3);
  st_be64(out + 24, a.2);
  st_be64(out + 32, a.1);
  st_be64(out + 40, a.0);
  return 0;
}

/* bytes_to_fq: 64 big-endian bytes at p (16 zero bytes || 48-byte value < p).
   Stores the element at out and returns 1; returns 0 for a value
   >= p (which includes any nonzero top byte). */
fun 1 fp_decode64(1 p, 1 out) {
  var 1 z = is_zero_bytes(p, 16);
  if z == 0 {
    return 0;
  }
  var FP c = fp_from_be48(p + 16);
  var 1 lt = fp_lt_raw(c, FP_P_LIT);
  if lt == 0 {
    return 0;
  }
  var FP m = fp_to_mont(c);
  st out, m;
  return 1;
}

/* Element at a -> 64 big-endian bytes (16 zero || 48). */
fun 1 fp_encode64(1 a, 1 out) {
  var FP m = lds FP a;
  var FP c = fp_from_mont(m);
  memzero(out, 16);
  fp_to_be48(c, out + 16);
  return 0;
}
