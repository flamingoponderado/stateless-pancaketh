/* lib/keccak.pnk -- Keccak-256 (Ethereum flavour: rate 136, pad 0x01..0x80,
   32-byte digest). Port of evm-asm/EvmAsm/Stateless/SpecRef/Crypto.lean
   (keccakPad, keccakAbsorbBlock, keccakAbsorb, keccak256); the permutation is
   Keccak-f[1600] on 25 little-endian 64-bit lanes, lane (x,y) at stp + 8*(x+5*y).
   GENERATED by tools/gen_keccak.py (round body fully unrolled); rotate-left by
   r is written as the Pancake rotate-right `#>> (64 - r)`. Do not hand-edit the
   round body. */

var 1 keccak_rc = 0;   /* 24 round constants, one word each */
var 1 keccak_st = 0;   /* 200-byte sponge state */
var 1 keccak_pad = 0;  /* 136-byte final-block scratch */

fun 1 keccak_init() {
  keccak_rc = alloc(192);
  keccak_st = alloc(200);
  keccak_pad = alloc(136);
  st keccak_rc + 0, 1;
  st keccak_rc + 8, 32898;
  st keccak_rc + 16, -9223372036854742902;
  st keccak_rc + 24, -9223372034707259392;
  st keccak_rc + 32, 32907;
  st keccak_rc + 40, 2147483649;
  st keccak_rc + 48, -9223372034707259263;
  st keccak_rc + 56, -9223372036854743031;
  st keccak_rc + 64, 138;
  st keccak_rc + 72, 136;
  st keccak_rc + 80, 2147516425;
  st keccak_rc + 88, 2147483658;
  st keccak_rc + 96, 2147516555;
  st keccak_rc + 104, -9223372036854775669;
  st keccak_rc + 112, -9223372036854742903;
  st keccak_rc + 120, -9223372036854743037;
  st keccak_rc + 128, -9223372036854743038;
  st keccak_rc + 136, -9223372036854775680;
  st keccak_rc + 144, 32778;
  st keccak_rc + 152, -9223372034707292150;
  st keccak_rc + 160, -9223372034707259263;
  st keccak_rc + 168, -9223372036854742912;
  st keccak_rc + 176, 2147483649;
  st keccak_rc + 184, -9223372034707259384;
  return 0;
}

/* Keccak-f[1600] on the 25-lane state at st. */
fun 1 keccak_f1600(1 stp) {
#ifdef ZISK_ACCEL
  /* Foreign-call convention: no configuration, and the 200-byte state is the
     array, so the accelerator reads and writes exactly the array. */
  @keccakf(stp, 0, stp, 200);
  return 0;
#endif
  var a00 = lds 1 (stp + 0);
  var a10 = lds 1 (stp + 8);
  var a20 = lds 1 (stp + 16);
  var a30 = lds 1 (stp + 24);
  var a40 = lds 1 (stp + 32);
  var a01 = lds 1 (stp + 40);
  var a11 = lds 1 (stp + 48);
  var a21 = lds 1 (stp + 56);
  var a31 = lds 1 (stp + 64);
  var a41 = lds 1 (stp + 72);
  var a02 = lds 1 (stp + 80);
  var a12 = lds 1 (stp + 88);
  var a22 = lds 1 (stp + 96);
  var a32 = lds 1 (stp + 104);
  var a42 = lds 1 (stp + 112);
  var a03 = lds 1 (stp + 120);
  var a13 = lds 1 (stp + 128);
  var a23 = lds 1 (stp + 136);
  var a33 = lds 1 (stp + 144);
  var a43 = lds 1 (stp + 152);
  var a04 = lds 1 (stp + 160);
  var a14 = lds 1 (stp + 168);
  var a24 = lds 1 (stp + 176);
  var a34 = lds 1 (stp + 184);
  var a44 = lds 1 (stp + 192);
  var r = 0;
  while r < 24 {
    var c0 = a00 ^ a01 ^ a02 ^ a03 ^ a04;
    var c1 = a10 ^ a11 ^ a12 ^ a13 ^ a14;
    var c2 = a20 ^ a21 ^ a22 ^ a23 ^ a24;
    var c3 = a30 ^ a31 ^ a32 ^ a33 ^ a34;
    var c4 = a40 ^ a41 ^ a42 ^ a43 ^ a44;
    var d0 = c4 ^ (c1 #>> 63);
    var d1 = c0 ^ (c2 #>> 63);
    var d2 = c1 ^ (c3 #>> 63);
    var d3 = c2 ^ (c4 #>> 63);
    var d4 = c3 ^ (c0 #>> 63);
    var b00 = (a00 ^ d0);
    var b10 = ((a11 ^ d1) #>> 20);
    var b20 = ((a22 ^ d2) #>> 21);
    var b30 = ((a33 ^ d3) #>> 43);
    var b40 = ((a44 ^ d4) #>> 50);
    var n00 = b00 ^ ((b10 | b20) ^ b10);
    var n10 = b10 ^ ((b20 | b30) ^ b20);
    var n20 = b20 ^ ((b30 | b40) ^ b30);
    var n30 = b30 ^ ((b40 | b00) ^ b40);
    var n40 = b40 ^ ((b00 | b10) ^ b00);
    var b01 = ((a30 ^ d3) #>> 36);
    var b11 = ((a41 ^ d4) #>> 44);
    var b21 = ((a02 ^ d0) #>> 61);
    var b31 = ((a13 ^ d1) #>> 19);
    var b41 = ((a24 ^ d2) #>> 3);
    var n01 = b01 ^ ((b11 | b21) ^ b11);
    var n11 = b11 ^ ((b21 | b31) ^ b21);
    var n21 = b21 ^ ((b31 | b41) ^ b31);
    var n31 = b31 ^ ((b41 | b01) ^ b41);
    var n41 = b41 ^ ((b01 | b11) ^ b01);
    var b02 = ((a10 ^ d1) #>> 63);
    var b12 = ((a21 ^ d2) #>> 58);
    var b22 = ((a32 ^ d3) #>> 39);
    var b32 = ((a43 ^ d4) #>> 56);
    var b42 = ((a04 ^ d0) #>> 46);
    var n02 = b02 ^ ((b12 | b22) ^ b12);
    var n12 = b12 ^ ((b22 | b32) ^ b22);
    var n22 = b22 ^ ((b32 | b42) ^ b32);
    var n32 = b32 ^ ((b42 | b02) ^ b42);
    var n42 = b42 ^ ((b02 | b12) ^ b02);
    var b03 = ((a40 ^ d4) #>> 37);
    var b13 = ((a01 ^ d0) #>> 28);
    var b23 = ((a12 ^ d1) #>> 54);
    var b33 = ((a23 ^ d2) #>> 49);
    var b43 = ((a34 ^ d3) #>> 8);
    var n03 = b03 ^ ((b13 | b23) ^ b13);
    var n13 = b13 ^ ((b23 | b33) ^ b23);
    var n23 = b23 ^ ((b33 | b43) ^ b33);
    var n33 = b33 ^ ((b43 | b03) ^ b43);
    var n43 = b43 ^ ((b03 | b13) ^ b03);
    var b04 = ((a20 ^ d2) #>> 2);
    var b14 = ((a31 ^ d3) #>> 9);
    var b24 = ((a42 ^ d4) #>> 25);
    var b34 = ((a03 ^ d0) #>> 23);
    var b44 = ((a14 ^ d1) #>> 62);
    var n04 = b04 ^ ((b14 | b24) ^ b14);
    var n14 = b14 ^ ((b24 | b34) ^ b24);
    var n24 = b24 ^ ((b34 | b44) ^ b34);
    var n34 = b34 ^ ((b44 | b04) ^ b44);
    var n44 = b44 ^ ((b04 | b14) ^ b04);
    a00 = n00;
    a10 = n10;
    a20 = n20;
    a30 = n30;
    a40 = n40;
    a01 = n01;
    a11 = n11;
    a21 = n21;
    a31 = n31;
    a41 = n41;
    a02 = n02;
    a12 = n12;
    a22 = n22;
    a32 = n32;
    a42 = n42;
    a03 = n03;
    a13 = n13;
    a23 = n23;
    a33 = n33;
    a43 = n43;
    a04 = n04;
    a14 = n14;
    a24 = n24;
    a34 = n34;
    a44 = n44;
    a00 = a00 ^ (lds 1 (keccak_rc + r * 8));
    r = r + 1;
  }
  st stp + 0, a00;
  st stp + 8, a10;
  st stp + 16, a20;
  st stp + 24, a30;
  st stp + 32, a40;
  st stp + 40, a01;
  st stp + 48, a11;
  st stp + 56, a21;
  st stp + 64, a31;
  st stp + 72, a41;
  st stp + 80, a02;
  st stp + 88, a12;
  st stp + 96, a22;
  st stp + 104, a32;
  st stp + 112, a42;
  st stp + 120, a03;
  st stp + 128, a13;
  st stp + 136, a23;
  st stp + 144, a33;
  st stp + 152, a43;
  st stp + 160, a04;
  st stp + 168, a14;
  st stp + 176, a24;
  st stp + 184, a34;
  st stp + 192, a44;
  return 0;
}

/* XOR the 136-byte block at blk into the state, then permute. */
fun 1 keccak_absorb_block(1 stp, 1 blk) {
  var i = 0;
  if (blk & 7) == 0 {
    while i < 136 {
      st stp + i, (lds 1 (stp + i)) ^ (lds 1 (blk + i));
      i = i + 8;
    }
  } else {
    while i < 136 {
      st stp + i, (lds 1 (stp + i)) ^ LD_LE64(blk + i);
      i = i + 8;
    }
  }
  keccak_f1600(stp);
  return 0;
}

/* keccak256 of the n bytes at p, written to the 32 bytes at out. */
fun 1 keccak256(1 p, 1 n, 1 out) {
  var stp = keccak_st;
  memzero(stp, 200);
  var i = 0;
  while i + 136 <=+ n {
    keccak_absorb_block(stp, p + i);
    i = i + 136;
  }
  var rem = n - i;             /* 0 <= rem < 136 */
  memzero(keccak_pad, 136);
  memcpy(keccak_pad, p + i, rem);
  st8 keccak_pad + rem, 1;
  st8 keccak_pad + 135, (ld8 (keccak_pad + 135)) | 128;   /* 0x81 when rem == 135 */
  keccak_absorb_block(stp, keccak_pad);
  if (out & 7) == 0 {
    st out, lds 1 stp;
    st out + 8, lds 1 (stp + 8);
    st out + 16, lds 1 (stp + 16);
    st out + 24, lds 1 (stp + 24);
  } else {
    memcpy(out, stp, 32);
  }
  return 0;
}
