/* lib/mem.pnk -- bump allocator over the Pancake heap and byte helpers.
   Persistent objects use [@base, HEAP_END); frame memory and scratch use the
   reserved [SCRATCH_BASE, SCRATCH_END) region before the Pancake heap. */

var 1 heap_ptr = 0;
var 1 journal_n = 0;   /* shared with state.pnk for trap diagnostics */

/* Raised after the runtime trap stub, so that a trap is terminal for any
   reader of the program that lets @trap return. Caught nowhere: on the
   machine ffitrap halts and the throw is dead code, and in the Lean model
   (Guest/Model.lean) it ends the run as `.raised` rather than letting the
   error paths run on past a deterministic halt. */
exception TrapErr : 1;

/* Record a fatal guest condition before entering the runtime trap stub.
   The metadata is outside the normal result and is consumed by eest-run. */
fun 1 trap_with(1 code) {
  !st8 OUTPUT_ADDR + 33, code;
  !stw OUTPUT_ADDR + 40, heap_ptr;
  !stw OUTPUT_ADDR + 48, journal_n;
  @trap(@base, code, @base, 0);
  throw TrapErr code;
}
var 1 scratch_ptr = 0;
var 1 frame_mem_ptr = 0;

fun 1 mem_init() {
  heap_ptr = @base;
  scratch_ptr = SCRATCH_END;
  frame_mem_ptr = SCRATCH_BASE;
  return 0;
}

/* Allocate n bytes, 8-byte aligned. Traps (deterministic halt) on OOM. */
fun 1 alloc(1 n) {
  var p = heap_ptr;
  if n >+ HEAP_END - p {
    trap_with(1);              /* also rejects n that would wrap p + n */
  }
  var q = (p + n + 7) & (0 - 8);
  if q >+ HEAP_END {
    trap_with(1);              /* allocation exhausted */
  }
  heap_ptr = q;
  return p;
}

fun 1 heap_mark() {
  return heap_ptr;
}

fun 1 heap_release(1 m) {
  heap_ptr = m;
  return 0;
}

/* Upward arena for EVM byte-addressable memory.  It is separate from the
   downward scratch arena so a frame can grow its memory in place after a
   child call releases its own arena slice. */
fun 1 frame_mem_alloc(1 n) {
  var p = frame_mem_ptr;
  if n >+ scratch_ptr - p {
    trap_with(6);
  }
  var q = (p + n + 7) & (0 - 8);
  if q >+ scratch_ptr {
    trap_with(6);              /* frame memory arena exhausted */
  }
  frame_mem_ptr = q;
  return p;
}

fun 1 frame_mem_mark() {
  return frame_mem_ptr;
}

fun 1 frame_mem_release(1 m) {
  frame_mem_ptr = m;
  return 0;
}

/* Allocate from the top of the reserved arena for short-lived frame scratch.
   A child frame can release its scratch without invalidating state records. */
fun 1 scratch_alloc(1 n) {
  var p = scratch_ptr;
  if n >+ p - frame_mem_ptr {
    trap_with(7);
  }
  var q = (p - n) & (0 - 8);
  if q <+ frame_mem_ptr {
    trap_with(7);              /* frame scratch arena exhausted */
  }
  scratch_ptr = q;
  return q;
}

fun 1 scratch_mark() {
  return scratch_ptr;
}

fun 1 scratch_release(1 m) {
  scratch_ptr = m;
  return 0;
}

fun 1 memcpy(1 dst, 1 src, 1 n) {
  var i = 0;
  if ((dst | src) & 7) == 0 {
    while i + 32 <=+ n {
      st dst + i, lds 1 (src + i);
      st dst + i + 8, lds 1 (src + i + 8);
      st dst + i + 16, lds 1 (src + i + 16);
      st dst + i + 24, lds 1 (src + i + 24);
      i = i + 32;
    }
    while i + 8 <=+ n {
      st dst + i, lds 1 (src + i);
      i = i + 8;
    }
  }
  while i + 8 <=+ n {
    st8 dst + i, ld8 (src + i);
    st8 dst + i + 1, ld8 (src + i + 1);
    st8 dst + i + 2, ld8 (src + i + 2);
    st8 dst + i + 3, ld8 (src + i + 3);
    st8 dst + i + 4, ld8 (src + i + 4);
    st8 dst + i + 5, ld8 (src + i + 5);
    st8 dst + i + 6, ld8 (src + i + 6);
    st8 dst + i + 7, ld8 (src + i + 7);
    i = i + 8;
  }
  while i <+ n {
    st8 dst + i, ld8 (src + i);
    i = i + 1;
  }
  return 0;
}

fun 1 memzero(1 dst, 1 n) {
  var i = 0;
  if (dst & 7) == 0 {
    while i + 32 <=+ n {
      st dst + i, 0;
      st dst + i + 8, 0;
      st dst + i + 16, 0;
      st dst + i + 24, 0;
      i = i + 32;
    }
    while i + 8 <=+ n {
      st dst + i, 0;
      i = i + 8;
    }
  }
  while i + 8 <=+ n {
    st8 dst + i, 0;
    st8 dst + i + 1, 0;
    st8 dst + i + 2, 0;
    st8 dst + i + 3, 0;
    st8 dst + i + 4, 0;
    st8 dst + i + 5, 0;
    st8 dst + i + 6, 0;
    st8 dst + i + 7, 0;
    i = i + 8;
  }
  while i <+ n {
    st8 dst + i, 0;
    i = i + 1;
  }
  return 0;
}

/* 1 if the n bytes at a and b are equal. */
fun 1 memeq(1 a, 1 b, 1 n) {
  var i = 0;
  if ((a | b) & 7) == 0 {
    if n == 20 {
      if (lds 1 a) != (lds 1 b) { return 0; }
      if (lds 1 (a + 8)) != (lds 1 (b + 8)) { return 0; }
      if (ld8 (a + 16)) != (ld8 (b + 16)) { return 0; }
      if (ld8 (a + 17)) != (ld8 (b + 17)) { return 0; }
      if (ld8 (a + 18)) != (ld8 (b + 18)) { return 0; }
      if (ld8 (a + 19)) != (ld8 (b + 19)) { return 0; }
      return 1;
    }
    if n == 32 {
      if (lds 1 a) != (lds 1 b) { return 0; }
      if (lds 1 (a + 8)) != (lds 1 (b + 8)) { return 0; }
      if (lds 1 (a + 16)) != (lds 1 (b + 16)) { return 0; }
      if (lds 1 (a + 24)) != (lds 1 (b + 24)) { return 0; }
      return 1;
    }
    if n == 52 {
      if (lds 1 a) != (lds 1 b) { return 0; }
      if (lds 1 (a + 8)) != (lds 1 (b + 8)) { return 0; }
      if (lds 1 (a + 16)) != (lds 1 (b + 16)) { return 0; }
      if (lds 1 (a + 24)) != (lds 1 (b + 24)) { return 0; }
      if (lds 1 (a + 32)) != (lds 1 (b + 32)) { return 0; }
      if (lds 1 (a + 40)) != (lds 1 (b + 40)) { return 0; }
      if (ld8 (a + 48)) != (ld8 (b + 48)) { return 0; }
      if (ld8 (a + 49)) != (ld8 (b + 49)) { return 0; }
      if (ld8 (a + 50)) != (ld8 (b + 50)) { return 0; }
      if (ld8 (a + 51)) != (ld8 (b + 51)) { return 0; }
      return 1;
    }
    while i + 32 <=+ n {
      if (lds 1 (a + i)) != (lds 1 (b + i)) {
        return 0;
      }
      if (lds 1 (a + i + 8)) != (lds 1 (b + i + 8)) {
        return 0;
      }
      if (lds 1 (a + i + 16)) != (lds 1 (b + i + 16)) {
        return 0;
      }
      if (lds 1 (a + i + 24)) != (lds 1 (b + i + 24)) {
        return 0;
      }
      i = i + 32;
    }
    while i + 8 <=+ n {
      if (lds 1 (a + i)) != (lds 1 (b + i)) {
        return 0;
      }
      i = i + 8;
    }
  }
  while i + 8 <=+ n {
    if (ld8 (a + i)) != (ld8 (b + i)) { return 0; }
    if (ld8 (a + i + 1)) != (ld8 (b + i + 1)) { return 0; }
    if (ld8 (a + i + 2)) != (ld8 (b + i + 2)) { return 0; }
    if (ld8 (a + i + 3)) != (ld8 (b + i + 3)) { return 0; }
    if (ld8 (a + i + 4)) != (ld8 (b + i + 4)) { return 0; }
    if (ld8 (a + i + 5)) != (ld8 (b + i + 5)) { return 0; }
    if (ld8 (a + i + 6)) != (ld8 (b + i + 6)) { return 0; }
    if (ld8 (a + i + 7)) != (ld8 (b + i + 7)) { return 0; }
    i = i + 8;
  }
  while i <+ n {
    if (ld8 (a + i)) != (ld8 (b + i)) {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

/* 1 if the n bytes at p are all zero. */
fun 1 is_zero_bytes(1 p, 1 n) {
  var i = 0;
  while i <+ n {
    if (ld8 (p + i)) != 0 {
      return 0;
    }
    i = i + 1;
  }
  return 1;
}

fun 1 ld_le32(1 p) {
  return LD_LE32(p);
}

fun 1 ld_le64(1 p) {
  return LD_LE64(p);
}

fun 1 ld_be32(1 p) {
  return LD_BE32(p);
}

/* Pancake has no byte-swap primitive. Keep the aligned word path in one
   helper so big-endian conversions can use lds/st instead of byte accesses. */
fun 1 bswap64(1 x) {
  x = ((x & 71777214294589695) << 8) | ((x >>> 8) & 71777214294589695);
  x = ((x & 281470681808895) << 16) | ((x >>> 16) & 281470681808895);
  return (x << 32) | (x >>> 32);
}

fun 1 ld_be64(1 p) {
  if (p & 7) == 0 {
    return bswap64(lds 1 p);
  }
  return LD_BE64(p);
}

fun 1 st_le32(1 p, 1 v) {
  st8 p, v;
  st8 p + 1, v >>> 8;
  st8 p + 2, v >>> 16;
  st8 p + 3, v >>> 24;
  return 0;
}

fun 1 st_le64(1 p, 1 v) {
  st_le32(p, v);
  st_le32(p + 4, v >>> 32);
  return 0;
}

fun 1 st_be32(1 p, 1 v) {
  st8 p, v >>> 24;
  st8 p + 1, v >>> 16;
  st8 p + 2, v >>> 8;
  st8 p + 3, v;
  return 0;
}

fun 1 st_be64(1 p, 1 v) {
  if (p & 7) == 0 {
    var 1 w = bswap64(v);
    st p, w;
    return 0;
  }
  st_be32(p, v >>> 32);
  st_be32(p + 4, v);
  return 0;
}

/* Copy the host-supplied input blob into the heap. Returns <ptr, len>. */
fun {1,1} input_blob() {
  var len = 0;
  !ldw len, INPUT_LEN_ADDR;
  if len >+ MAX_INPUT_LEN {
    trap_with(8);              /* length cannot fit the host input region */
  }
  var p = alloc(len + 8);
  var i = 0;
  var w = 0;
  while i <+ len {
    !ldw w, INPUT_DATA_ADDR + i;   /* input is zero padded to 8 bytes */
    st p + i, w;
    i = i + 8;
  }
  return <p, len>;
}

/* Write n bytes from heap address src to the public output region. */
fun 1 output_write(1 src, 1 n) {
  var i = 0;
  while i <+ n {
    !st8 OUTPUT_ADDR + i, ld8 (src + i);
    i = i + 1;
  }
  return 0;
}

fun 1 min(1 a, 1 b) {
  if a <+ b { return a; }
  return b;
}

fun 1 max(1 a, 1 b) {
  if a >+ b { return a; }
  return b;
}
