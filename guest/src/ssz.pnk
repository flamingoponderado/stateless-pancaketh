/* ssz.pnk -- SSZ decoding (SszCodec.lean deserializeAux, Ssz.lean
   ssz_to_* conversions) and merkleization (hashTreeRoot) for the stateless
   guest. Decoding errors raise SszErr, which the shell maps to the
   deserialize-failure sentinel (Guest.lean run_stateless_guest). */

exception SszErr : 1;

var 1 zero_hashes = 0;   /* 64 chunks: Z_d = sha256(Z_{d-1} || Z_{d-1}) */
var 1 ssz_len_chunk = 0; /* scratch for mix_in_length */
var 1 ssz_offs = 0;      /* scratch for up to 8 container offsets */

/* Z_0 = 0, Z_{d+1} = sha256(Z_d || Z_d): precomputed (generated with
   Python hashlib; equal by definition to the reference recurrence). */
fun 1 ssz_init() {
  if zero_hashes != 0 {
    return 0;
  }
  ssz_len_chunk = alloc(32);
  ssz_offs = alloc(64);
  zero_hashes = alloc(64 * 32);
  st zero_hashes + 0, 0;
  st zero_hashes + 8, 0;
  st zero_hashes + 16, 0;
  st zero_hashes + 24, 0;
  st zero_hashes + 32, 3467889160079910389;
  st zero_hashes + 40, -7235303472643467225;
